  view {
    If(settings_page) {
      Overlay {
        MainContent()
        Center { SettingsModal() }
      }
    } else {
      If(project_switch_confirm_open) {
        Overlay {
          MainContent()
          Center { ProjectSwitchConfirmModal() }
        }
      } else {
      If(composition_remove_confirm_open) {
        Overlay {
          MainContent()
          Center { CompositionRemoveConfirmModal() }
        }
      } else {
      If(layer_remove_confirm_open) {
        Overlay {
          MainContent()
          Center { LayerRemoveConfirmModal() }
        }
      } else {
      If(exit_confirm_open) {
        Overlay {
          MainContent()
          Center { ExitConfirmModal() }
        }
      } else {
        MainContent()
      }
      }
      }
      }
    }
  }
}
