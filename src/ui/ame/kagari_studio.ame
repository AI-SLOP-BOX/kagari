app AfterEffectsStudio {
  window {
    title: "KAGARI VFX"
    size: 1600, 1000
    min_size: 640, 480
  }
  theme dark;

  import "state/records.ame";
  import "state/bindings.ame";
  import "state/actions.ame";


  import "components/navigation.ame";
  import "components/home.ame";
  import "components/projects.ame";
  import "components/activity.ame";
  import "components/documents.ame";
  import "components/project_setup.ame";
  import "components/settings.ame";
  import "components/export.ame";
  import "components/asset_panel.ame";
  import "components/scene_panel.ame";
  import "components/project_panel.ame";
  import "components/composition_panel.ame";
  import "components/properties_transform.ame";
  import "components/properties_content.ame";
  import "components/properties_appearance.ame";
  import "components/properties_advanced.ame";
  import "components/properties_panel.ame";
  import "components/effect_panel.ame";
  import "components/animation_panel.ame";
  import "components/audio_mixer_panel.ame";
  import "components/time_remap_panel.ame";
  import "components/graph_editor_panel.ame";
  import "components/timeline_markers.ame";
  import "components/flowchart_panel.ame";
  import "components/timeline.ame";
  import "components/topbar.ame";
  import "components/toolbar.ame";
  import "components/status_bar.ame";
  import "components/workspace_layout.ame";

  view {
    If(settings_page) {
      SettingsPanel()
    } else {
      If(project_switch_confirm_open) {
        Overlay {
          MainContent()
          Center { ProjectSwitchConfirmModal() }
        }
      } else {
      If(composition_remove_confirm_open) {
        Overlay {
          MainContent()
          Center { CompositionRemoveConfirmModal() }
        }
      } else {
      If(layer_remove_confirm_open) {
        Overlay {
          MainContent()
          Center { LayerRemoveConfirmModal() }
        }
      } else {
      If(exit_confirm_open) {
        Overlay {
          MainContent()
          Center { ExitConfirmModal() }
        }
      } else {
        MainContent()
      }
      }
      }
      }
    }
  }
}
