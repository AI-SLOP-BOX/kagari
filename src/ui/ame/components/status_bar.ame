component StatusBar() {
    VStack(spacing: 0) {
      Surface(padding: 0, spacing: 0, radius: 0, border: false, background: "#222732") { Spacer }.frame(height: 1)
      Surface(padding: 5, spacing: 0, radius: 0, border: false, background: "#101216") {
        If(wide) {
          HStack(spacing: 10) {
            HStack(spacing: 6) {
              Svg("<svg xmlns='http://www.w3.org/2000/svg' width='8' height='8' viewBox='0 0 8 8'><circle cx='4' cy='4' r='3.5' fill='#38bdf8'/></svg>", 8, 8)
              Text("Kagari Studio", size: 12).weight(semibold)
            }
            Surface(padding: 3, spacing: 0, radius: 4, border: false, background: "#162436") {
              Caption("{preview_badge}")
            }
            Caption("{status_resolution}")
            Caption("·")
            Caption("{status_frame}")
            If(preview_fallback_reason != "") {
              Caption("({preview_fallback_reason})")
            }
            Spacer
            Surface(padding: 2, spacing: 0, radius: 6, border: true, background: "#141820") {
              HStack(spacing: 2) {
                If(is_default_workspace) { Button("編集", action: workspace_default, tone: primary, size: small) } else { Button("編集", action: workspace_default, tone: ghost, size: small) }
                If(is_graph_workspace) { Button("グラフ", action: workspace_graph, tone: primary, size: small) } else { Button("グラフ", action: workspace_graph, tone: ghost, size: small) }
                If(timeline_view_flowchart) { Button("ノード", action: timeline_view_flowchart, tone: primary, size: small) } else { Button("ノード", action: timeline_view_flowchart, tone: ghost, size: small) }
                If(is_effects_workspace) { Button("エフェクト", action: workspace_effects, tone: primary, size: small) } else { Button("エフェクト", action: workspace_effects, tone: ghost, size: small) }
                If(is_camera_light_workspace) { Button("3D", action: workspace_camera_light, tone: primary, size: small) } else { Button("3D", action: workspace_camera_light, tone: ghost, size: small) }
                If(is_color_workspace) { Button("カラー", action: workspace_color, tone: primary, size: small) } else { Button("カラー", action: workspace_color, tone: ghost, size: small) }
                If(export_page) { Button("書き出し", action: go_export, tone: primary, size: small) } else { Button("書き出し", action: go_export, tone: ghost, size: small) }
              }
            }
            Spacer
            Caption("{current_time}")
            Caption("·")
            Caption("{save_status}")
          }
        } else {
          If(compact) {
            HStack(spacing: 8) { Text("Kagari", size: 12).weight(semibold) Caption("{preview_badge}") Spacer Caption("{save_status}") }
          } else {
            HStack(spacing: 8) {
              Text("Kagari", size: 12).weight(semibold)
              Caption("{status_resolution}")
              Caption("·")
              Caption("{status_frame}")
              Caption("·")
              Caption("{preview_badge}")
              Spacer
              Caption("{current_time}")
              Caption("{save_status}")
            }
          }
        }
      }
    }
  }
