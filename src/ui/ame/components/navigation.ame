component HomeNavRail() {
    If(narrow) {
      MinWidth(72) {
        VStack(spacing: 0) {
          Padding(10) { Center { AssetImage("kagari.logo", 1, 34, 34) } }
          VStack(spacing: 6) {
            CompactNavItem(active: home_page, label: "ホーム") { Positioned(left: 0, right: 0, top: 0, bottom: 0) { Center { If(home_page) { AssetImage("kagari.nav.home.active", 1, 20, 20) } else { AssetImage("kagari.nav.home", 1, 20, 20) } } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("ホーム", action: go_home, tone: secondary).opacity(nav_hitbox_opacity) } }
            CompactNavItem(active: projects_page, label: "プロジェクト") { Positioned(left: 0, right: 0, top: 0, bottom: 0) { Center { If(projects_page) { AssetImage("kagari.nav.projects.active", 1, 20, 20) } else { AssetImage("kagari.nav.projects", 1, 20, 20) } } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("プロジェクト", action: go_projects, tone: secondary).opacity(nav_hitbox_opacity) } }
            CompactNavItem(active: documents_page, label: "ドキュメント") { Positioned(left: 0, right: 0, top: 0, bottom: 0) { Center { If(documents_page) { AssetImage("kagari.nav.documents.active", 1, 20, 20) } else { AssetImage("kagari.nav.documents", 1, 20, 20) } } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("ドキュメント", action: go_documents, tone: secondary).opacity(nav_hitbox_opacity) } }
            CompactNavItem(active: settings_nav_active, label: "設定") { Positioned(left: 0, right: 0, top: 0, bottom: 0) { Center { If(settings_nav_active) { AssetImage("kagari.nav.settings.active", 1, 20, 20) } else { AssetImage("kagari.nav.settings", 1, 20, 20) } } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("設定", action: go_settings, tone: secondary).opacity(nav_hitbox_opacity) } }
            CompactNavItem(active: false, label: "終了") { Positioned(left: 0, right: 0, top: 0, bottom: 0) { Center { AssetImage("kagari.nav.exit", 1, 20, 20) } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("終了", action: exit_app, tone: secondary).opacity(nav_hitbox_opacity) } }
          }
          Spacer
          Padding(4) { Center { Caption("v0.3.0") } }
        }
      }
    } else {
      MaxWidth(280) { MinWidth(260) {
        Padding(0) {
          VStack(spacing: 0) {
            Padding(10) { HStack(spacing: 12) { AssetImage("kagari.logo", 1, 34, 34) Text("Kagari VFX", size: 18) } }
            VStack(spacing: 28) {
              VStack(spacing: 0) {
                If(home_page) { ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='294' height='56' viewBox='0 0 294 56'><rect x='13' y='0' width='268' height='56' rx='12' fill='#2a1c16'/><rect x='13' y='0' width='3' height='56' rx='2.5' fill='#f58c4b'/></svg>", 234, 56) Padding(18) { HStack(spacing: 16) { AssetImage("kagari.nav.home.active", 1, 20, 20) Text("ホーム", size: 16) Spacer } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("ホーム", action: go_home, tone: secondary).opacity(nav_hitbox_opacity) } } } else { ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='294' height='56' viewBox='0 0 294 56'><rect width='294' height='56' fill='transparent'/></svg>", 234, 56) Padding(18) { HStack(spacing: 16) { AssetImage("kagari.nav.home", 1, 20, 20) Text("ホーム", size: 16) Spacer } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("ホーム", action: go_home, tone: secondary).opacity(nav_hitbox_opacity) } } }
                If(projects_page) { ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='294' height='56' viewBox='0 0 294 56'><rect x='13' y='0' width='268' height='56' rx='12' fill='#2a1c16'/><rect x='13' y='0' width='3' height='56' rx='2.5' fill='#f58c4b'/></svg>", 234, 56) Padding(18) { HStack(spacing: 16) { AssetImage("kagari.nav.projects.active", 1, 20, 20) Text("プロジェクト", size: 16) Spacer } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("プロジェクト", action: go_projects, tone: secondary).opacity(nav_hitbox_opacity) } } } else { ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='294' height='56' viewBox='0 0 294 56'><rect width='294' height='56' fill='transparent'/></svg>", 234, 56) Padding(18) { HStack(spacing: 16) { AssetImage("kagari.nav.projects", 1, 20, 20) Text("プロジェクト", size: 16) Spacer } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("プロジェクト", action: go_projects, tone: secondary).opacity(nav_hitbox_opacity) } } }
                If(documents_page) { ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='294' height='56' viewBox='0 0 294 56'><rect x='13' y='0' width='268' height='56' rx='12' fill='#2a1c16'/><rect x='13' y='0' width='3' height='56' rx='2.5' fill='#f58c4b'/></svg>", 234, 56) Padding(18) { HStack(spacing: 16) { AssetImage("kagari.nav.documents.active", 1, 20, 20) Text("ドキュメント", size: 16) Spacer } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("ドキュメント", action: go_documents, tone: secondary).opacity(nav_hitbox_opacity) } } } else { ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='294' height='56' viewBox='0 0 294 56'><rect width='294' height='56' fill='transparent'/></svg>", 234, 56) Padding(18) { HStack(spacing: 16) { AssetImage("kagari.nav.documents", 1, 20, 20) Text("ドキュメント", size: 16) Spacer } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("ドキュメント", action: go_documents, tone: secondary).opacity(nav_hitbox_opacity) } } }
                If(settings_nav_active) { ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='294' height='56' viewBox='0 0 294 56'><rect x='13' y='0' width='268' height='56' rx='12' fill='#2a1c16'/><rect x='13' y='0' width='3' height='56' rx='2.5' fill='#f58c4b'/></svg>", 234, 56) Padding(18) { HStack(spacing: 16) { AssetImage("kagari.nav.settings.active", 1, 20, 20) Text("設定", size: 16) Spacer } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("設定", action: go_settings, tone: secondary).opacity(nav_hitbox_opacity) } } } else { ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='294' height='56' viewBox='0 0 294 56'><rect width='294' height='56' fill='transparent'/></svg>", 234, 56) Padding(18) { HStack(spacing: 16) { AssetImage("kagari.nav.settings", 1, 20, 20) Text("設定", size: 16) Spacer } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("設定", action: go_settings, tone: secondary).opacity(nav_hitbox_opacity) } } }
                ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='294' height='56' viewBox='0 0 294 56'><rect width='294' height='56' fill='transparent'/></svg>", 234, 56) Padding(18) { HStack(spacing: 16) { AssetImage("kagari.nav.exit", 1, 20, 20) Text("終了", size: 16) Spacer } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("終了", action: exit_app, tone: secondary).opacity(nav_hitbox_opacity) } }
              }
            }
            Spacer
            Padding(20) { Caption("Kagari VFX\nv0.3.0") }
          }
        }
      }
      }
    }
    }
component CompactNavItem(active: Bool, label: String) {
    ZStack {
      If(active) { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='64' height='56' viewBox='0 0 64 56'><rect x='4' y='2' width='56' height='52' rx='12' fill='#2a1c16'/><rect x='4' y='2' width='3' height='52' rx='2.5' fill='#f58c4b'/></svg>", 64, 56) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='64' height='56' viewBox='0 0 64 56'><rect width='64' height='56' fill='transparent'/></svg>", 64, 56) }
      slot
    }
  }
component SettingsCompactNav() {
    VStack(spacing: 4) {
      ZStack { If(settings_general) { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' rx='8' fill='#1d2026'/><rect width='3' height='40' rx='2' fill='#f58c4b'/></svg>", 48, 40) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' fill='transparent'/></svg>", 48, 40) } Align(center) { If(settings_general) { AssetImage("kagari.preferences.general.active", 1, 20, 20) } else { AssetImage("kagari.preferences.general", 1, 20, 20) } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("一般", action: settings_general_select, tone: secondary).opacity(nav_hitbox_opacity) } }
      ZStack { If(settings_projects) { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' rx='8' fill='#1d2026'/><rect width='3' height='40' rx='2' fill='#f58c4b'/></svg>", 48, 40) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' fill='transparent'/></svg>", 48, 40) } Align(center) { If(settings_projects) { AssetImage("kagari.preferences.projects.active", 1, 20, 20) } else { AssetImage("kagari.preferences.projects", 1, 20, 20) } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("プロジェクト", action: settings_projects_select, tone: secondary).opacity(nav_hitbox_opacity) } }
      ZStack { If(settings_cache) { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' rx='8' fill='#1d2026'/><rect width='3' height='40' rx='2' fill='#f58c4b'/></svg>", 48, 40) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' fill='transparent'/></svg>", 48, 40) } Align(center) { If(settings_cache) { AssetImage("kagari.preferences.cache.active", 1, 20, 20) } else { AssetImage("kagari.preferences.cache", 1, 20, 20) } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("メディアとキャッシュ", action: settings_cache_select, tone: secondary).opacity(nav_hitbox_opacity) } }
      ZStack { If(settings_performance) { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' rx='8' fill='#1d2026'/><rect width='3' height='40' rx='2' fill='#f58c4b'/></svg>", 48, 40) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' fill='transparent'/></svg>", 48, 40) } Align(center) { If(settings_performance) { AssetImage("kagari.preferences.performance.active", 1, 20, 20) } else { AssetImage("kagari.preferences.performance", 1, 20, 20) } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("パフォーマンス", action: settings_performance_select, tone: secondary).opacity(nav_hitbox_opacity) } }
      ZStack { If(settings_shortcuts) { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' rx='8' fill='#1d2026'/><rect width='3' height='40' rx='2' fill='#f58c4b'/></svg>", 48, 40) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' fill='transparent'/></svg>", 48, 40) } Align(center) { If(settings_shortcuts) { AssetImage("kagari.preferences.shortcuts.active", 1, 20, 20) } else { AssetImage("kagari.preferences.shortcuts", 1, 20, 20) } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("ショートカット", action: settings_shortcuts_select, tone: secondary).opacity(nav_hitbox_opacity) } }
      ZStack { If(settings_interface) { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' rx='8' fill='#1d2026'/><rect width='3' height='40' rx='2' fill='#f58c4b'/></svg>", 48, 40) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' fill='transparent'/></svg>", 48, 40) } Align(center) { If(settings_interface) { AssetImage("kagari.preferences.interface.active", 1, 20, 20) } else { AssetImage("kagari.preferences.interface", 1, 20, 20) } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("インターフェース", action: settings_interface_select, tone: secondary).opacity(nav_hitbox_opacity) } }
      ZStack { If(settings_plugins) { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' rx='8' fill='#1d2026'/><rect width='3' height='40' rx='2' fill='#f58c4b'/></svg>", 48, 40) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' fill='transparent'/></svg>", 48, 40) } Align(center) { If(settings_plugins) { AssetImage("kagari.preferences.plugins.active", 1, 20, 20) } else { AssetImage("kagari.preferences.plugins", 1, 20, 20) } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("プラグイン", action: settings_plugins_select, tone: secondary).opacity(nav_hitbox_opacity) } }
      ZStack { If(settings_license) { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' rx='8' fill='#1d2026'/><rect width='3' height='40' rx='2' fill='#f58c4b'/></svg>", 48, 40) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='40' viewBox='0 0 48 40'><rect width='48' height='40' fill='transparent'/></svg>", 48, 40) } Align(center) { If(settings_license) { AssetImage("kagari.preferences.license.active", 1, 20, 20) } else { AssetImage("kagari.preferences.license", 1, 20, 20) } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("ライセンス", action: settings_license_select, tone: secondary).opacity(nav_hitbox_opacity) } }
    }
  }
