            }
            HitArea("プロジェクト", action: go_projects) {
              If(projects_page) { ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='180' height='40' viewBox='0 0 180 40'><rect x='0' y='0' width='180' height='40' rx='8' fill='#232933'/><rect x='8' y='9' width='3' height='22' rx='1.5' fill='#f58c4b'/></svg>", 180, 40) Padding(horizontal: 18, vertical: 10) { HStack(spacing: 10) { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#ff8a36' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z'/></svg>", 16, 16) Text("{t.nav_projects}", size: 14).weight(semibold) Spacer } } } } else { ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='180' height='40' viewBox='0 0 180 40'><rect width='180' height='40' fill='transparent'/></svg>", 180, 40) Padding(horizontal: 18, vertical: 10) { HStack(spacing: 10) { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#aeb7bd' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z'/></svg>", 16, 16) Text("{t.nav_projects}", size: 14) Spacer } } } }
            }
            HitArea("テンプレート", action: new_project) {
              ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='180' height='40' viewBox='0 0 180 40'><rect width='180' height='40' fill='transparent'/></svg>", 180, 40) Padding(horizontal: 18, vertical: 10) { HStack(spacing: 10) { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#aeb7bd' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='18' height='18' rx='2'/><path d='M3 9h18M9 21V9'/></svg>", 16, 16) Text("{t.nav_templates}", size: 14) Spacer } } }
            }
            HitArea("設定", action: go_settings) {
              If(settings_nav_active) { ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='180' height='40' viewBox='0 0 180 40'><rect x='0' y='0' width='180' height='40' rx='8' fill='#232933'/><rect x='8' y='9' width='3' height='22' rx='1.5' fill='#f58c4b'/></svg>", 180, 40) Padding(horizontal: 18, vertical: 10) { HStack(spacing: 10) { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#ff8a36' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z'/><circle cx='12' cy='12' r='3'/></svg>", 16, 16) Text("{t.nav_settings}", size: 14).weight(semibold) Spacer } } } } else { ZStack { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='180' height='40' viewBox='0 0 180 40'><rect width='180' height='40' fill='transparent'/></svg>", 180, 40) Padding(horizontal: 18, vertical: 10) { HStack(spacing: 10) { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#aeb7bd' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-