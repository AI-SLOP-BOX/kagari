component HomeNavRail() {
    If(ui_locale != "") {
    If(narrow) {
      MinWidth(72) {
        VStack(spacing: 0) {
          Padding(10) { Center { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='34' height='34' viewBox='0 0 24 24'><rect x='1' y='1' width='22' height='22' rx='6' fill='#1c2129' stroke='#ff8a2a' stroke-width='1.5'/><path d='M12 4.5L17.5 12L12 19.5L6.5 12Z' fill='#ff8a2a'/><path d='M12 8.5L14.8 12L12 15.5L9.2 12Z' fill='#ffd180'/></svg>", 34, 34) } }
          VStack(spacing: 6) {
            HitArea("ホーム", action: go_home) { CompactNavItem(active: home_page, label: "ホーム") { Positioned(left: 0, right: 0, top: 0, bottom: 0) { Center { If(home_page) { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#ff8a36' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/></svg>", 20, 20) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#aeb7bd' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/></svg>", 20, 20) } } } } }
            HitArea("プロジェクト", action: go_projects) { CompactNavItem(active: projects_page, label: "プロジェクト") { Positioned(left: 0, right: 0, top: 0, bottom: 0) { Center { If(projects_page) { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#ff8a36' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z'/></svg>", 20, 20) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#aeb7bd' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z'/></svg>", 20, 20) } } } } }
            HitArea("ドキュメント", action: go_documents) { CompactNavItem(active: documents_page, label: "ドキュメント") { Positioned(left: 0, right: 0, top: 0, bottom: 0) { Center { If(documents_page) { AssetImage("kagari.nav.documents.active", 1, 20, 20) } else { AssetImage("kagari.nav.documents", 1, 20, 20) } } } } }
            HitArea("設定", action: go_settings) { CompactNavItem(active: settings_nav_active, label: "設定") { Positioned(left: 0, right: 0, top: 0, bottom: 0) { Center { If(settings_nav_active) { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#ff8a36' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z'/><circle cx='12' cy='12' r='3'/></svg>", 20, 20) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#aeb7bd' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z'/><circle cx='12' cy='12' r='3'/></svg>", 20, 20) } } } } }
            HitArea("終了", action: exit_app) { CompactNavItem(active: false, label: "終了") { Positioned(left: 0, right: 0, top: 0, bottom: 0) { Center { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#aeb7bd' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2v10'/><path d='M7.1 5.2a9 9 0 1 0 9.8 0'/></svg>", 20, 20) } } } }
          }
          Spacer
          Padding(4) { Center { Caption("v0.3.0") } }
        }
      }
    } else {
      Grow(1) { MaxWidth(220) { Grow(1) { MinWidth(208) { Grow(1) {
        Surface(padding: 14, spacing: 10, radius: 0, border: false, background: "#14181f") {
