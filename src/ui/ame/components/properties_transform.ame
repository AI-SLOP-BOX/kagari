component TransformProperties() {
  Card(hover_strength: 0.0, hover_elevation: 0.0) { Padding(4) { VStack(spacing: 4) {
    Surface(padding: 5, spacing: 0, radius: 4, border: false, background: "#14181f") {
      HStack(spacing: 4) {
        Text("▎ 変形 (Transform)", size: 12).weight(semibold)
        Spacer
        If(selected_layer_locked) { Caption("🔒") }
      }
    }
    Surface(padding: 6, spacing: 0, radius: 5, border: false, background: "#14181f") { VStack(spacing: 3) {
      HStack(spacing: 4) {
        MinWidth(56) { Caption("位置 (X / Y)") }
        If(selected_layer_locked) { Caption("{position_x} , {position_y}") }
        Spacer
        IconButton("diamond", action: keyframe_position_2d, tone: ghost, size: small, disabled: selected_layer_locked)
      }
      If(!selected_layer_locked) {
        VStack(spacing: 3) {
          HStack(spacing: 4) { Caption("X") Grow(1) { DragValue(position_x, min: -100000.0, max: 100000.0, action: position_x_changed) } }
          HStack(spacing: 4) { Caption("Y") Grow(1) { DragValue(position_y, min: -100000.0, max: 100000.0, action: position_y_changed) } }
        }
      }
      HStack(spacing: 4) {
        MinWidth(56) { Caption("基準点 (X / Y)") }
        If(selected_layer_locked) { Caption("{anchor_x} , {anchor_y}") }
        Spacer
        IconButton("diamond", action: keyframe_anchor_point, tone: ghost, size: small, disabled: selected_layer_locked)
      }
      If(!selected_layer_locked) {
        VStack(spacing: 3) {
          HStack(spacing: 4) { Caption("X") Grow(1) { DragValue(anchor_x, min: -100000.0, max: 100000.0, action: anchor_x_changed) } }
          HStack(spacing: 4) { Caption("Y") Grow(1) { DragValue(anchor_y, min: -100000.0, max: 100000.0, action: anchor_y_changed) } }
        }
      }
    } }
    Surface(padding: 6, spacing: 0, radius: 5, border: false, background: "#14181f") { VStack(spacing: 4) {
      HStack(spacing: 4) {
        MinWidth(56) { Caption("スケール (%)") }
        If(selected_layer_locked) { Caption("{scale_x}% × {scale_y}%") }
        Spacer
        IconButton("diamond", action: keyframe_scale_2d, tone: ghost, size: small, disabled: selected_layer_locked)
      }
      If(!selected_layer_locked) {
        VStack(spacing: 3) {
          HStack(spacing: 4) { Caption("X") Grow(1) { DragValue(scale_x, min: 0.1, max: 1000.0, action: scale_x_changed) } }
          HStack(spacing: 4) { Caption("Y") Grow(1) { DragValue(scale_y, min: 0.1, max: 1000.0, action: scale_y_changed) } }
        }
      }
      HStack(spacing: 4) {
        MinWidth(56) { Caption("回転 (°)") }
        If(selected_layer_locked) { Caption("{rotation_degrees}°") }
        Spacer
        IconButton("diamond", action: keyframe_rotation_2d, tone: ghost, size: small, disabled: selected_layer_locked)
      }
      If(!selected_layer_locked) {
        DragValue(rotation_degrees, min: -36000.0, max: 36000.0, action: rotation_changed)
      }
      HStack(spacing: 4) {
        MinWidth(56) { Caption("不透明度 (%)") }
        If(selected_layer_locked) { Caption("{opacity}%") }
        Spacer
        IconButton("diamond", action: keyframe_opacity, tone: ghost, size: small, disabled: selected_layer_locked)
      }
      If(!selected_layer_locked) {
        DragValue(opacity, min: 0.0, max: 100.0, action: opacity_changed)
      }
    } }
  } } }
}

component LayerConstraintsProperties() {
  Card(hover_strength: 0.0, hover_elevation: 0.0) { Padding(6) { VStack(spacing: 5) {
    Caption("▎ コンポジションリサイズ時の追従")
    HStack(spacing: 5) {
      MinWidth(68) { Caption("水平方向") }
      If(selected_layer_locked) {
        Caption("{layer_constraint_horizontal}")
      } else {
        Select(layer_constraint_horizontal, action: select_constraint_horizontal) {
          Option("左固定", "左固定")
          Option("中央固定", "中央固定")
          Option("右固定", "右固定")
          Option("幅に比例", "幅に比例")
        }
      }
      Spacer
    }
    HStack(spacing: 5) {
      MinWidth(68) { Caption("垂直方向") }
      If(selected_layer_locked) {
        Caption("{layer_constraint_vertical}")
      } else {
        Select(layer_constraint_vertical, action: select_constraint_vertical) {
          Option("上固定", "上固定")
          Option("中央固定", "中央固定")
          Option("下固定", "下固定")
          Option("高さに比例", "高さに比例")
        }
      }
      Spacer
    }
    Caption("コンポジションの縦横サイズを変更した時に、レイヤー位置を維持します。")
  } } }
}

component Transform3DProperties() {
  Card(hover_strength: 0.0, hover_elevation: 0.0) { Padding(6) { VStack(spacing: 5) {
    Caption("▎ 3D変形 · XYZ")
    HStack(spacing: 4) { Caption("位置") Spacer IconButton("diamond", action: keyframe_position_3d, tone: ghost, size: small, disabled: selected_layer_locked) }
    VStack(spacing: 3) {
      HStack(spacing: 4) { Caption("X") If(selected_layer_locked) { Caption("{position_3d_x}") } else { Grow(1) { DragValue(position_3d_x, min: -100000.0, max: 100000.0, action: position_3d_x_changed) } } }
      HStack(spacing: 4) { Caption("Y") If(selected_layer_locked) { Caption("{position_3d_y}") } else { Grow(1) { DragValue(position_3d_y, min: -100000.0, max: 100000.0, action: position_3d_y_changed) } } }
      HStack(spacing: 4) { Caption("Z") If(selected_layer_locked) { Caption("{position_3d_z}") } else { Grow(1) { DragValue(position_3d_z, min: -100000.0, max: 100000.0, action: position_3d_z_changed) } } }
    }
    HStack(spacing: 4) { Caption("回転 (°)") Spacer IconButton("diamond", action: keyframe_rotation_3d, tone: ghost, size: small, disabled: selected_layer_locked) }
    VStack(spacing: 3) {
      HStack(spacing: 4) { Caption("X") If(selected_layer_locked) { Caption("{rotation_3d_x}") } else { Grow(1) { DragValue(rotation_3d_x, min: -36000.0, max: 36000.0, action: rotation_3d_x_changed) } } }
      HStack(spacing: 4) { Caption("Y") If(selected_layer_locked) { Caption("{rotation_3d_y}") } else { Grow(1) { DragValue(rotation_3d_y, min: -36000.0, max: 36000.0, action: rotation_3d_y_changed) } } }
      HStack(spacing: 4) { Caption("Z") If(selected_layer_locked) { Caption("{rotation_3d_z}") } else { Grow(1) { DragValue(rotation_3d_z, min: -36000.0, max: 36000.0, action: rotation_3d_z_changed) } } }
    }
    HStack(spacing: 4) { Caption("倍率 (%)") Spacer IconButton("diamond", action: keyframe_scale_3d, tone: ghost, size: small, disabled: selected_layer_locked) }
    VStack(spacing: 3) {
      HStack(spacing: 4) { Caption("X") If(selected_layer_locked) { Caption("{scale_3d_x}") } else { Grow(1) { DragValue(scale_3d_x, min: 0.1, max: 1000.0, action: scale_3d_x_changed) } } }
      HStack(spacing: 4) { Caption("Y") If(selected_layer_locked) { Caption("{scale_3d_y}") } else { Grow(1) { DragValue(scale_3d_y, min: 0.1, max: 1000.0, action: scale_3d_y_changed) } } }
      HStack(spacing: 4) { Caption("Z") If(selected_layer_locked) { Caption("{scale_3d_z}") } else { Grow(1) { DragValue(scale_3d_z, min: 0.1, max: 1000.0, action: scale_3d_z_changed) } } }
    }
    Caption("マテリアル · ライティング")
    VStack(spacing: 3) {
      HStack(spacing: 4) { Caption("環境光") If(selected_layer_locked) { Caption("{material_ambient}") } else { Grow(1) { DragValue(material_ambient, min: 0.0, max: 1.0, action: material_ambient_changed) } } }
      HStack(spacing: 4) { Caption("拡散") If(selected_layer_locked) { Caption("{material_diffuse}") } else { Grow(1) { DragValue(material_diffuse, min: 0.0, max: 1.0, action: material_diffuse_changed) } } }
      HStack(spacing: 4) { Caption("鏡面") If(selected_layer_locked) { Caption("{material_specular}") } else { Grow(1) { DragValue(material_specular, min: 0.0, max: 1.0, action: material_specular_changed) } } }
      HStack(spacing: 4) { Caption("鋭さ") If(selected_layer_locked) { Caption("{material_specular_exponent}") } else { Grow(1) { DragValue(material_specular_exponent, min: 1.0, max: 256.0, action: material_specular_exponent_changed) } } }
      HStack(spacing: 4) { Caption("発光") If(selected_layer_locked) { Caption("{material_emission}") } else { Grow(1) { DragValue(material_emission, min: 0.0, max: 1.0, action: material_emission_changed) } } }
      HStack(spacing: 4) { Caption("金属") If(selected_layer_locked) { Caption("{material_metalness}") } else { Grow(1) { DragValue(material_metalness, min: 0.0, max: 1.0, action: material_metalness_changed) } } }
      HStack(spacing: 4) { Caption("透過%") If(selected_layer_locked) { Caption("{material_light_transmission}") } else { Grow(1) { DragValue(material_light_transmission, min: 0.0, max: 100.0, action: material_light_transmission_changed) } } }
    }
    Wrap(item_spacing: 4, line_spacing: 4) {
      If(material_cast_shadows) { Button("影を落とす", action: toggle_material_cast_shadows, tone: primary, size: small, disabled: selected_layer_locked) } else { Button("影を落とす", action: toggle_material_cast_shadows, tone: ghost, size: small, disabled: selected_layer_locked) }
      If(material_accepts_shadows) { Button("影を受ける", action: toggle_material_accepts_shadows, tone: primary, size: small, disabled: selected_layer_locked) } else { Button("影を受ける", action: toggle_material_accepts_shadows, tone: ghost, size: small, disabled: selected_layer_locked) }
      If(material_accepts_lights) { Button("ライトを受ける", action: toggle_material_accepts_lights, tone: primary, size: small, disabled: selected_layer_locked) } else { Button("ライトを受ける", action: toggle_material_accepts_lights, tone: ghost, size: small, disabled: selected_layer_locked) }
    }
  } } }
}
