component CommandSearchButton() {
    HitArea("検索", action: toggle_command_palette) {
      ZStack {
        Svg("<svg xmlns='http://www.w3.org/2000/svg' width='214' height='32' viewBox='0 0 214 32'><rect x='0.5' y='0.5' width='213' height='31' rx='15.5' fill='#1c2129' stroke='#2d3442'/></svg>", 214, 32)
        Padding(horizontal: 12, vertical: 6) {
          HStack(spacing: 8) {
            Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#8d95a2' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='7'/><path d='m21 21-4.3-4.3'/></svg>", 14, 14)
            Text("検索...", size: 12)
            Spacer
            ZStack {
              Svg("<svg xmlns='http://www.w3.org/2000/svg' width='38' height='20' viewBox='0 0 38 20'><rect width='38' height='20' rx='5' fill='#2a303c'/></svg>", 38, 20)
              Center { Text("⌘ K", size: 11) }
            }
          }
        }
      }
    }
  }

component AppBar() {
    Padding(horizontal: 12, vertical: 6) {
      If(narrow) {
        Wrap(item_spacing: 6, line_spacing: 4) {
          HStack(spacing: 6) {
            Svg("<svg xmlns='http://www.w3.org/2000/svg' width='22' height='22' viewBox='0 0 24 24'><rect x='1' y='1' width='22' height='22' rx='6' fill='#1c2129' stroke='#ff8a2a' stroke-width='1.5'/><path d='M12 4.5L17.5 12L12 19.5L6.5 12Z' fill='#ff8a2a'/><path d='M12 8.5L14.8 12L12 15.5L9.2 12Z' fill='#ffd180'/></svg>", 22, 22)
            Text("Kagari Studio", size: 13).weight(semibold)
          }
          If(home_page) {
            Button("ホーム", action: go_home, tone: primary, size: small)
          } else {
            Button("ホーム", action: go_home, tone: ghost, size: small)
          }
          If(editor_page) {
            If(is_color_workspace) {
              Button("編集", action: workspace_default, tone: ghost, size: small)
              Button("カラー", action: workspace_color, tone: primary, size: small)
              Button("エフェクト", action: workspace_effects, tone: ghost, size: small)
            } else {
              If(is_effects_workspace) {
                Button("編集", action: workspace_default, tone: ghost, size: small)
                Button("カラー", action: workspace_color, tone: ghost, size: small)
                Button("エフェクト", action: workspace_effects, tone: primary, size: small)
              } else {
                Button("編集", action: back_to_editor, tone: primary, size: small)
                Button("カラー", action: workspace_color, tone: ghost, size: small)
                Button("エフェクト", action: workspace_effects, tone: ghost, size: small)
              }
            }
          } else {
            Button("編集", action: back_to_editor, tone: ghost, size: small)
            Button("カラー", action: workspace_color, tone: ghost, size: small)
            Button("エフェクト", action: workspace_effects, tone: ghost, size: small)
          }
          If(export_page) {
            Button("書き出し", action: go_export, tone: primary, size: small)
          } else {
            Button("書き出し", action: go_export, tone: ghost, size: small)
          }
          If(editor_page) {
            Button("保存", action: save_project, tone: primary, size: small)
          }
          Button("コマンド", action: toggle_command_palette, tone: ghost, size: small)
          If(settings_page) {
            IconButton("settings", action: go_settings, tone: primary, size: small)
          } else {
            IconButton("settings", action: go_settings, tone: ghost, size: small)
          }
        }
      } else {
        HStack(spacing: 12) {
          HStack(spacing: 8) {
            Svg("<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'><rect x='1' y='1' width='22' height='22' rx='6' fill='#1c2129' stroke='#ff8a2a' stroke-width='1.5'/><path d='M12 4.5L17.5 12L12 19.5L6.5 12Z' fill='#ff8a2a'/><path d='M12 8.5L14.8 12L12 15.5L9.2 12Z' fill='#ffd180'/></svg>", 24, 24)
            Text("Kagari Studio", size: 14).weight(semibold)
          }
          Spacer
          If(editor_page || export_page) {
            Surface(padding: 3, spacing: 0, radius: 6, border: true, background: "#12151a") {
              HStack(spacing: 2) {
                Button("ホーム", action: go_home, tone: ghost, size: small)
                If(editor_page && !is_color_workspace && !is_effects_workspace) {
                  Button("編集", action: workspace_default, tone: primary, size: small)
                } else {
                  Button("編集", action: back_to_editor, tone: ghost, size: small)
                }
                If(editor_page && is_color_workspace) {
                  Button("カラー", action: workspace_color, tone: primary, size: small)
                } else {
                  Button("カラー", action: workspace_color, tone: ghost, size: small)
                }
                If(editor_page && is_effects_workspace) {
                  Button("エフェクト", action: workspace_effects, tone: primary, size: small)
                } else {
                  Button("エフェクト", action: workspace_effects, tone: ghost, size: small)
                }
                If(export_page) {
                  Button("書き出し", action: go_export, tone: primary, size: small)
                } else {
                  Button("書き出し", action: go_export, tone: ghost, size: small)
                }
              }
            }
            Spacer
          }
          HStack(spacing: 8) {
            If(editor_page) {
              Surface(padding: 4, spacing: 0, radius: 5, border: false, background: "#14181f") {
                HStack(spacing: 8) {
                  Caption("{project_summary}")
                  Caption("·")
                  Caption("{save_status}")
                }
              }
              Button("保存", action: save_project, tone: primary, size: small)
            }
            CommandSearchButton()
            If(editor_page || export_page) {
              HitArea("go_settings", action: go_settings) { If(settings_page) {
                  Svg("<svg xmlns='http://www.w3.org/2000/svg' width='34' height='32' viewBox='0 0 34 32'><rect x='0.5' y='0.5' width='33' height='31' rx='8' fill='#2a1c16' stroke='#f58c4b'/></svg>", 34, 32)
                } else {
                  Svg("<svg xmlns='http://www.w3.org/2000/svg' width='34' height='32' viewBox='0 0 34 32'><rect x='0.5' y='0.5' width='33' height='31' rx='8' fill='#1c2129' stroke='#2d3442'/></svg>", 34, 32)
                }
                Center {
                  Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#d8dee4' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z'/><circle cx='12' cy='12' r='3'/></svg>", 16, 16)
                } }
            }
          }
        }
      }
    }
  }
