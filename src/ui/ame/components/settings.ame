import "settings/general.ame";
import "settings/performance.ame";
import "settings/media.ame";
import "settings/display.ame";
import "settings/playback.ame";
import "settings/shortcuts.ame";
import "settings/filepath.ame";
import "settings/external.ame";
import "settings/experimental.ame";

component SettingsNavItem(active: Bool) {
    ZStack {
        If(active) { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='188' height='40' viewBox='0 0 188 40'><rect width='188' height='40' rx='8' fill='#4f3728'/><rect x='0' y='5' width='4.5' height='30' rx='2.25' fill='#f39c29'/></svg>", 188, 40) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' width='188' height='40' viewBox='0 0 188 40'><rect width='188' height='40' fill='transparent'/></svg>", 188, 40) }
        slot
    }
}

component SettingsGeneralNav() { SettingsNavItem(active: settings_general) { Padding(horizontal: 10, vertical: 8) { HStack(spacing: 12) { If(settings_general) { AssetImage("kagari.preferences.general.active", 1, 20, 20) } else { AssetImage("kagari.preferences.general", 1, 20, 20) } Text("一般", size: 13) Spacer } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("", action: settings_general_select, tone: secondary).opacity(nav_hitbox_opacity) } } }

