component SettingsPanel() {
    Padding(18) {
      VStack(spacing: 12) {
        HStack(spacing: 10) {
          Title("環境設定")
          Spacer
          Button("閉じる", action: close_settings, tone: secondary, size: small)
        }
        Grow(1) {
          HStack(spacing: 12) {
            Card(padding: 10, spacing: 6) {
              SettingsGeneralNav()
              SettingsPerformanceNav()
              SettingsMediaNav()
              SettingsDisplayNav()
              SettingsPlaybackNav()
              SettingsShortcutsNav()
              SettingsFilepathNav()
              SettingsExternalNav()
              SettingsExperimentalNav()
              Spacer
            }
            Grow(1) {
              ScrollView(500) {
                VStack(spacing: 16) {
                  If(settings_feedback != "") { Caption("{settings_feedback}") }
                  If(settings_general) { SettingsGeneralPage() }
                  If(settings_performance) { SettingsPerformancePage() }
                  If(settings_media) { SettingsMediaPage() }
                  If(settings_display) { SettingsDisplayPage() }
                  If(settings_playback) { SettingsPlaybackPage() }
                  If(settings_shortcuts) { SettingsShortcutsPage() }
                  If(settings_filepath) { SettingsFilepathPage() }
                  If(settings_external) { SettingsExternalPage() }
                  If(settings_experimental) { SettingsExperimentalPage() }
                }
              }
            }
          }
        }
        HStack(spacing: 10) {
          Button("デフォルトに戻す", action: settings_defaults, tone: secondary)
          Spacer
          Button("キャンセル", action: settings_cancel, tone: secondary)
          Button("OK", action: settings_apply, tone: primary)
        }
      }
    }
  }

component ExitConfirmModal() {
    MaxWidth(420) {
      Card {
        Padding(22) {
          VStack(spacing: 14) {
            Text("Kagari VFX を終了しますか？", size: 20)
            Caption("保存していない変更がある場合は、終了する前に保存してください。")
            HStack(spacing: 10) {
              Spacer
              Button("キャンセル", action: cancel_exit_app, tone: secondary)
              Button("終了", action: confirm_exit_app, tone: destructive)
            }
          }
        }
      }
    }
  }

component ProjectSwitchConfirmModal() {
    MaxWidth(620) {
      Card {
        Padding(22) {
          VStack(spacing: 14) {
            Text("未保存の変更があります", size: 20)
            Caption("新しいプロジェクトへ移ると、現在の未保存変更は失われます。先に保存しますか？")
            HStack(spacing: 10) {
              Spacer
              Button("キャンセル", action: cancel_project_switch, tone: secondary)
              Button("保存して切り替え", action: save_and_confirm_project_switch, tone: primary)
              Button("保存せず切り替え", action: confirm_project_switch, tone: destructive)
            }
          }
        }
      }
    }
  }
