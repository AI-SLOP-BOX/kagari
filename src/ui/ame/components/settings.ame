component SettingsExperimentalNav() { SettingsNavItem(active: settings_experimental) { Padding(horizontal: 10, vertical: 8) { HStack(spacing: 12) { If(settings_experimental) { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#ff8a36' stroke-width='1.8' stroke-linecap='round'><path d='M4 7h7M15 7h5M4 12h10M18 12h2M4 17h4M12 17h8'/><circle cx='13' cy='7' r='1.6'/><circle cx='16' cy='12' r='1.6'/><circle cx='10' cy='17' r='1.6'/></svg>", 20, 20) } else { Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#aeb7bd' stroke-width='1.8' stroke-linecap='round'><path d='M4 7h7M15 7h5M4 12h10M18 12h2M4 17h4M12 17h8'/><circle cx='13' cy='7' r='1.6'/><circle cx='16' cy='12' r='1.6'/><circle cx='10' cy='17' r='1.6'/></svg>", 20, 20) } Text("実験的機能", size: 13) Spacer } } Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("", action: settings_experimental_select, tone: secondary).opacity(nav_hitbox_opacity) } } }

component SettingsPanel() {
    Padding(18) {
      VStack(spacing: 12) {
        HStack(spacing: 10) {
          Title("環境設定")
          Spacer
          Button("閉じる", action: close_settings, tone: secondary, size: small)
        }
        Grow(1) {
          HStack(spacing: 12) {
            Card(padding: 10, spacing: 6) {
              SettingsGeneralNav()
              SettingsPerformanceNav()
              SettingsMediaNav()
              SettingsDisplayNav()
              SettingsPlaybackNav()
              SettingsShortcutsNav()
              SettingsFilepathNav()
              SettingsExternalNav()
              SettingsExperimentalNav()
              Spacer
            }
            Grow(1) {
              ScrollView(500) {
                VStack(spacing: 16) {
                  If(settings_feedback != "") { Caption("{settings_feedback}") }
                  If(settings_general) { SettingsGeneralPage() }
                  If(settings_performance) { SettingsPerformancePage() }
                  If(settings_media) { SettingsMediaPage() }
                  If(settings_display) { SettingsDisplayPage() }
                  If(settings_playback) { SettingsPlaybackPage() }
                  If(settings_shortcuts) { SettingsShortcutsPage() }
                  If(settings_filepath) { SettingsFilepathPage() }
                  If(settings_external) { SettingsExternalPage() }
                  If(settings_experimental) { SettingsExperimentalPage() }
                }
              }
            }
          }
        }
        HStack(spacing: 10) {
          Button("デフォルトに戻す", action: settings_defaults, tone: secondary)
          Spacer
          Button("キャンセル", action: settings_cancel, tone: secondary)
          Button("OK", action: settings_apply, tone: primary)
        }
      }
    }
  }

component ExitConfirmModal() {
    MaxWidth(420) {
      Card {
        Padding(22) {
          VStack(spacing: 14) {
            If(project_is_dirty) {
              Text("未保存の変更があります", size: 20)
              Caption("終了前にプロジェクトを保存するか、変更を破棄してください。")
              HStack(spacing: 10) {
                Spacer
                Button("キャンセル", action: cancel_exit_app, tone: secondary)
                Button("保存せずに終了", action: confirm_exit_app, tone: destructive)
                Button("保存して終了", action: save_and_exit_app, tone: primary)
              }
            } else {
              Text("Kagari VFX を終了しますか？", size: 20)
              HStack(spacing: 10) {
                Spacer
                Button("キャンセル", action: cancel_exit_app, tone: secondary)
                Button("終了", action: confirm_exit_app, tone: destructive)
              }
            }
          }
        }
      }
    }
  }

component ProjectSwitchConfirmModal() {
    MaxWidth(620) {
      Card {
        Padding(22) {
          VStack(spacing: 14) {
            Text("未保存の変更があります", size: 20)
            Caption("新しいプロジェクトへ移ると、現在の未保存変更は失われます。先に保存しますか？")
            HStack(spacing: 10) {
              Spacer
              Button("キャンセル", action: cancel_project_switch, tone: secondary)
              Button("保存して切り替え", action: save_and_confirm_project_switch, tone: primary)
              Button("保存せず切り替え", action: confirm_project_switch, tone: destructive)
            }
          }
        }
      }
    }
  }
