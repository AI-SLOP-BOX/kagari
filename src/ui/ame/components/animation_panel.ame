component AnimationPanel() {
  Padding(4) { VStack(spacing: 4) {
    Wrap(item_spacing: 4, line_spacing: 4) {
      Text("モーション", size: 14)
      If(selected_layer && !selected_layer_locked) {
        Caption("現在フレームにキーを追加")
        If(selected_is_3d) {
          Button("3D位置", action: keyframe_position_3d, tone: ghost, size: small)
          Button("3D回転", action: keyframe_rotation_3d, tone: ghost, size: small)
          Button("3D倍率", action: keyframe_scale_3d, tone: ghost, size: small)
        } else {
          Button("位置", action: keyframe_position_2d, tone: ghost, size: small)
          Button("回転", action: keyframe_rotation_2d, tone: ghost, size: small)
          Button("倍率", action: keyframe_scale_2d, tone: ghost, size: small)
        }
        Button("不透明度", action: keyframe_opacity, tone: ghost, size: small)
        If(selected_is_camera) {
          Button("画角", action: keyframe_camera_fov, tone: ghost, size: small)
          Button("焦点距離", action: keyframe_camera_focus, tone: ghost, size: small)
          Button("絞り", action: keyframe_camera_aperture, tone: ghost, size: small)
        }
        If(selected_is_light) { Button("ライト強度", action: keyframe_light_intensity, tone: ghost, size: small) }
      } else {
        If(selected_layer_locked) { Caption("レイヤーがロックされています") } else {
        Caption("シーンからレイヤーを選択してください")
        }
      }
    }
    If(selected_layer && !selected_layer_locked) {
      VStack(spacing: 5) {
        HStack(spacing: 5) {
          Caption("アニメーションプリセット")
          Spacer
          MaxWidth(180) { TextField(animation_preset_search, "プリセットを検索", action: animation_preset_search_changed) }
        }
        If(has_animation_preset_items) {
          HorizontalScrollView(720) {
            HStack(spacing: 4) {
              ForEach(animation_preset_items, preset, key: id) {
                Button("{preset.label}", action: apply_animation_preset, tone: ghost, size: small, disabled: selected_layer_locked)
              }
            }
          }
        } else {
          Caption("対応するプリセットはありません。")
        }
        If(animation_preset_status != "") { Caption("{animation_preset_status}") }
      }

      Wrap(item_spacing: 4, line_spacing: 4) {
        Button("前のキー", action: previous_keyframe, tone: ghost, size: small)
        Button("次のキー", action: next_keyframe, tone: ghost, size: small)
        Button("全キーをイージーイーズ", action: ease_selected_layer, tone: ghost, size: small)
        If(timeline_view_graph) { Button("グラフ表示中", action: timeline_view_graph, tone: primary, size: small) } else { Button("グラフエディターを開く", action: timeline_view_graph, tone: ghost, size: small) }
        Caption("キーを選択してタイミングと補間を調整")
      }
    }
  } }
}
