component GraphEditorPanel() {
  Card(padding: 8, spacing: 6, hover_strength: 0.0, hover_elevation: 0.0) {
    Surface(padding: 5, spacing: 0, radius: 5, border: false, background: "#14181f") {
      Wrap(item_spacing: 4, line_spacing: 4) {
        Text("値カーブ", size: 13).weight(semibold)
      If(has_graph_channels) {
        HorizontalScrollView(360) {
          HStack(spacing: 3) {
            ForEach(graph_channels, channel, key: id) {
              If(channel.selected) { Button("{channel.label}", action: graph_channel_select, tone: primary, size: small) } else { Button("{channel.label}", action: graph_channel_select, tone: ghost, size: small) }
            }
          }
        }
      }
      Button("次へ", action: graph_channel_next, tone: ghost, size: small)
      If(graph_effect_channel) { Button("次のエフェクト値", action: graph_effect_parameter_next, tone: ghost, size: small) }
      If(graph_effect_channel) {
        HorizontalScrollView(260) {
          HStack(spacing: 3) {
            ForEach(graph_parameter_items, parameter, key: id) {
              If(parameter.selected) { Button("{parameter.label}", action: graph_effect_parameter_select, tone: primary, size: small) } else { Button("{parameter.label}", action: graph_effect_parameter_select, tone: ghost, size: small) }
            }
          }
        }
      }
      IconButton("add", action: graph_add_keyframe, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
      IconButton("trash", action: graph_remove_keyframe, tone: destructive, size: small, disabled: !selected_layer || selected_layer_locked)
      }
    }
    Surface(padding: 4, spacing: 0, radius: 5, border: false, background: "#11141a") {
      Wrap(item_spacing: 4, line_spacing: 4) {
      Button("補間: {graph_interpolation_label}", action: graph_cycle_interpolation, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
      Button("イージング (F9)", action: graph_set_easy_ease, tone: primary, size: small, disabled: !selected_layer || selected_layer_locked)
      Button("⤥ イーズイン", action: graph_set_ease_in, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
      Button("⤦ イーズアウト", action: graph_set_ease_out, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
      Button("⤹ オーバースイング", action: graph_set_overshoot, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
      Button("⌇ バウンス", action: graph_set_bounce, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
      Button("サイン波", action: graph_set_sine, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
      Button("／ リニア", action: graph_set_linear, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
      Button("⎍ 停止 (Hold)", action: graph_set_hold, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
      }
    }
    Canvas("kagari.graph")
      .relative_frame(height: 0.65, min_height: 220, max_height: 900)
      .context_menu() {
        Item("キーフレームを追加", action: graph_add_keyframe)
        Item("イージング (F9)", action: graph_set_easy_ease)
        Item("補間を切り替え", action: graph_cycle_interpolation)
      }
    If(!graph_has_keyframes) { Caption("選択レイヤーのキーを追加すると値カーブを編集できます") } else { Caption("点をドラッグして時間と値を変更") }
  }
}
