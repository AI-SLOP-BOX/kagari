component AppScreen() {
    If(project_setup_page) { ProjectSetupPanel() } else { If(home_page) { HomePanel() } else { If(activity_page) { ActivityPanel() } else {
      If(projects_page) { ProjectsPanel() } else {
        If(documents_page) {
          If(docs_detail_page) { DocsDetailPanel() } else { DocumentsPanel() }
        } else {
          If(export_page) { ExportPanel() } else {
            Padding(3) { VStack(spacing: 3) { ToolBar() WorkArea() StatusBar() } }
          }
        }
      }
    } } }
  }

component MainContent() {
    Padding(0) {
      VStack(spacing: 4) {
        If(editor_page) { AppBar() } else { If(export_page) { AppBar() } }
        Grow(1) { AppScreen() }
      }
    }
  }
