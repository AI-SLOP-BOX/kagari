            ScrollView(520) { SceneHierarchyPanel() }
          }
          SplitPane(Horizontal, workspace_center_ratio, action: workspace_center_resized) {
            SplitPane(Vertical, workspace_vertical_ratio, action: workspace_vertical_resized) {
              CompositionPreview()
              TimelinePanel()
            }
            ScrollView(760) { ColorWorkspacePanel() }
          }
        }
      }
    } else {
