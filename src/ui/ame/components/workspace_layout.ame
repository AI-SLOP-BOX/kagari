component WorkArea() {
    If(is_camera_light_workspace) {
      If(compact) {
        ScrollView(760) { VStack(spacing: 8) { CompositionPreview() CameraLightWorkspacePanel() TimelinePanel() } }
      } else {
        SplitPane(Horizontal, workspace_left_ratio, action: workspace_left_resized) {
          ScrollView(760) { SceneHierarchyPanel() }
          SplitPane(Horizontal, workspace_center_ratio, action: workspace_center_resized) {
            SplitPane(Vertical, workspace_vertical_ratio, action: workspace_vertical_resized) { CompositionPreview() TimelinePanel() }
            ScrollView(760) { CameraLightWorkspacePanel() }
          }
        }
      }
    } else {
    If(is_color_workspace) {
      If(compact) {
        ScrollView(760) {
          VStack(spacing: 8) { CompositionPreview() ColorWorkspacePanel() TimelinePanel() }
