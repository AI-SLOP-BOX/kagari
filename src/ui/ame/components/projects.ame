component ProjectsPanel() {
    HStack(spacing: 0) {
      Align(stretch) { HomeNavRail() }
      Grow(1) {
        Align(stretch) {
          VStack(spacing: 0) {
            Padding(horizontal: 24, vertical: 14) {
              VStack(spacing: 12) {
                HStack(spacing: 10) {
                  Text("プロジェクト", size: 20).weight(bold)
                  Spacer
                  HitArea("open_project", action: open_project) { ZStack {
                      Svg("<svg xmlns='http://www.w3.org/2000/svg' width='82' height='32' viewBox='0 0 82 32'><rect x='0.5' y='0.5' width='81' height='31' rx='8' fill='#1c2129' stroke='#2d3442'/></svg>", 82, 32)
                      Center {
                        HStack(spacing: 6) {
                          Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#aeb7bd' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6l-2-2H5a2 2 0 0 0-2 2z'/></svg>", 14, 14)
                          Text("開く", size: 12).weight(medium)
                        }
                      }
                    } }
                  HitArea("new_project", action: new_project) { ZStack {
                      Svg("<svg xmlns='http://www.w3.org/2000/svg' width='104' height='32' viewBox='0 0 104 32'><rect x='0.5' y='0.5' width='103' height='31' rx='8' fill='#262d38' stroke='#3a4454'/></svg>", 104, 32)
                      Center {
                        HStack(spacing: 5) {
                          Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#d8dee4' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><line x1='12' y1='5' x2='12' y2='19'/><line x1='5' y1='12' x2='19' y2='12'/></svg>", 13, 13)
                          Text("新規作成", size: 12).weight(medium)
                        }
                      }
                    } }
                }

                HStack(spacing: 8) {
                  Grow(1) { TextField(project_search, "プロジェクトを検索", action: project_search_changed) }
                  MinWidth(156) {
                    MaxWidth(164) {
                      Select(project_sort, action: project_sort_changed) {
                        Option("updated", "更新順")
                        Option("name", "名前順")
                        Option("created", "作成順")
                      }
                    }
                  }
                  HitArea("project_sort_toggle_dir", action: project_sort_toggle_dir) { ZStack {
                      Svg("<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><rect x='0.5' y='0.5' width='31' height='31' rx='8' fill='#1c2129' stroke='#2d3442'/></svg>", 32, 32)
                      Center {
                        If(project_sort_desc) {
                          Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#d8dee4' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='m3 16 4 4 4-4'/><path d='M7 20V4'/><path d='M11 4h10'/><path d='M11 8h7'/><path d='M11 12h4'/></svg>", 15, 15)
                        } else {
                          Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#d8dee4' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='m3 8 4-4 4 4'/><path d='M7 4v16'/><path d='M11 12h4'/><path d='M11 16h7'/><path d='M11 20h10'/></svg>", 15, 15)
                        }
                      }
                    } }
                  HitArea("project_view_toggle", action: project_view_toggle) { ZStack {
                      Svg("<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><rect x='0.5' y='0.5' width='31' height='31' rx='8' fill='#1c2129' stroke='#2d3442'/></svg>", 32, 32)
                      Center {
                        If(project_view_grid) {
                          Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#d8dee4' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='7' height='7' rx='1'/><rect x='14' y='3' width='7' height='7' rx='1'/><rect x='3' y='14' width='7' height='7' rx='1'/><rect x='14' y='14' width='7' height='7' rx='1'/></svg>", 15, 15)
                        } else {
                          Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#d8dee4' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><line x1='8' y1='6' x2='21' y2='6'/><line x1='8' y1='12' x2='21' y2='12'/><line x1='8' y1='18' x2='21' y2='18'/><line x1='3' y1='6' x2='3.01' y2='6'/><line x1='3' y1='12' x2='3.01' y2='12'/><line x1='3' y1='18' x2='3.01' y2='18'/></svg>", 15, 15)
                        }
                      }
                    } }
                }

                HStack(spacing: 10) {
                  If(project_has_selection) {
                    HStack(spacing: 8) {
                      Caption("{project_selection_label}")
                      HitArea("project_open_selected", action: project_open_selected) { Padding(horizontal: 6, vertical: 2) { Text("開く", size: 12).weight(medium) } }
                      HitArea("project_remove_selected", action: project_remove_selected) { Padding(horizontal: 6, vertical: 2) { Text("一覧から削除", size: 12).weight(medium) } }
                      HitArea("project_clear_selection", action: project_clear_selection) { Padding(horizontal: 6, vertical: 2) { Caption("解除") } }
                    }
                  } else {
                    Caption("{project_count_label}")
                  }
                  Spacer
                  If(!project_view_grid) {
                    HStack(spacing: 8) {
                      HitArea("project_sort_by_name", action: project_sort_by_name) { Caption("名前") }
                      Caption("/")
                      HitArea("project_sort_by_updated", action: project_sort_by_updated) { Caption("更新日時") }
                      Caption("/")
                      Caption("保存先")
                    }
                  }
                }
              }
            }

            Grow(1) {
              ScrollView(760) {
                Padding(horizontal: 24, vertical: 4) {
                  If(has_recents) {
                    If(has_project_matches) {
                      If(project_view_grid) {
                        Wrap(item_spacing: 12, line_spacing: 12) {
                          ForEach(project_items, project, key: path) {
                            MaxWidth(280) {
                              HitArea("open_recent_project", action: open_recent_project) { Card(padding: 12, spacing: 8) {
                                  HStack(spacing: 8) {
                                    HitArea("project_toggle_select", action: project_toggle_select) { If(project.selected) {
                                        Svg("<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'><rect width='16' height='16' rx='4' fill='#f58c4b'/><path d='m4 8 3 3 5-5' fill='none' stroke='#10141a' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>", 16, 16)
                                      } else {
                                        Svg("<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'><rect x='0.5' y='0.5' width='15' height='15' rx='3.5' fill='transparent' stroke='#3d4656'/></svg>", 16, 16)
                                      } }
                                    Text("{project.name}", size: 14).weight(semibold)
                                    Spacer
                                  }
                                  AssetImage("kagari.home.recent.1", 1, 256, 144)
                                  Caption("{project.specs}")
                                  HStack(spacing: 6) {
                                    Caption("{project.date}")
                                    Spacer
                                    Caption("{project.location}")
                                  }
                                } }.context_menu() {
                                Item("開く (Enter)", action: open_recent_project)
                                Item("選択を切り替え", action: project_toggle_select)
                                Item("複製", action: project_duplicate_item)
                                Item("保存先を開く", action: project_reveal_item)
                                Item("一覧から削除 (Delete)", action: project_remove_selected)
                              }
                            }
                          }
                        }
                      } else {
                        VStack(spacing: 6) {
                          ForEach(project_items, project, key: path) {
                            ZStack {
                              Card(padding: 10, spacing: 0) {
                                HStack(spacing: 12) {
                                  HitArea("project_toggle_select", action: project_toggle_select) { If(project.selected) {
                                      Svg("<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'><rect width='16' height='16' rx='4' fill='#f58c4b'/><path d='m4 8 3 3 5-5' fill='none' stroke='#10141a' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>", 16, 16)
                                    } else {
                                      Svg("<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'><rect x='0.5' y='0.5' width='15' height='15' rx='3.5' fill='transparent' stroke='#3d4656'/></svg>", 16, 16)
                                    } }
                                  HitArea("open_recent_project", action: open_recent_project) {
                                    HStack(spacing: 12) {
                                      AssetImage("kagari.home.recent.1", 1, 72, 42)
                                      VStack(spacing: 2) {
                                        Text("{project.name}", size: 14).weight(semibold)
                                        Caption("{project.specs}")
                                      }
                                      Spacer
                                      VStack(spacing: 2) {
                                        HStack(spacing: 0) { Spacer Caption("{project.date}") }
                                        HStack(spacing: 0) { Spacer Caption("{project.location}") }
                                      }
                                    }
                                  }
                                  HitArea("open_recent_project", action: open_recent_project) {
                                    ZStack {
                                      Svg("<svg xmlns='http://www.w3.org/2000/svg' width='28' height='28' viewBox='0 0 28 28'><rect width='28' height='28' rx='6' fill='transparent'/></svg>", 28, 28)
                                      Center {
                                        Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#8d95a2' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='1'/><circle cx='19' cy='12' r='1'/><circle cx='5' cy='12' r='1'/></svg>", 15, 15)
                                      }
                                    }
                                  }
                                }
                              }
                            }.context_menu() {
                              Item("開く (Enter)", action: open_recent_project)
                              Item("選択を切り替え", action: project_toggle_select)
                              Item("複製", action: project_duplicate_item)
                              Item("保存先を開く", action: project_reveal_item)
                              Item("一覧から削除 (Delete)", action: project_remove_selected)
                            }
                          }
                        }
                      }
                    } else {
                      Card(hover_strength: 0.0, hover_elevation: 0.0) { Padding(18) { Caption("検索条件に一致するプロジェクトはありません。") } }
                    }
                  } else {
                    Card(hover_strength: 0.0, hover_elevation: 0.0) { Padding(18) { Caption("プロジェクトはまだありません。右上の「開く」または「新規作成」から始められます。") } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
