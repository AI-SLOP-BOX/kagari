component ProjectSetupPanel() {
    ScrollView(760) {
      Padding(horizontal: 24, vertical: 12) {
        Center {
          MaxWidth(680) {
            VStack(spacing: 14) {
              HStack(spacing: 12) {
                ZStack {
                  Svg("<svg xmlns='http://www.w3.org/2000/svg' width='40' height='40' viewBox='0 0 40 40'><rect x='0.5' y='0.5' width='39' height='39' rx='10' fill='#1c2129' stroke='#2d3442'/></svg>", 40, 40)
                  Center {
                    Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#d8dee4' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 10v6'/><path d='M9 13h6'/><path d='M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z'/></svg>", 18, 18)
                  }
                }
                VStack(spacing: 3) {
                  Text("新規プロジェクト", size: 22).weight(bold)
                  Caption("プロジェクトの名前と保存先を設定します。")
                }
                Spacer
                HitArea("setup_cancel", action: setup_cancel) { ZStack {
                    Svg("<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='transparent'/></svg>", 32, 32)
                    Center {
                      Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#8d95a2' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg>", 16, 16)
                    }
                  } }
              }

              Surface(padding: 0, spacing: 0, radius: 0, border: false, background: "#212733") { Spacer }.frame(height: 1)

              VStack(spacing: 8) {
                Text("プロジェクト名", size: 13).weight(medium)
                TextField(setup_name, "無題のプロジェクト", action: setup_name_changed)
              }

              VStack(spacing: 8) {
                Text("保存先", size: 13).weight(medium)
                HStack(spacing: 10) {
                  Grow(1) { TextField(setup_location, "~/Documents/Kagari Studio/Projects", action: setup_location_changed) }
                  HitArea("open_project", action: open_project) { ZStack {
                      Svg("<svg xmlns='http://www.w3.org/2000/svg' width='84' height='36' viewBox='0 0 84 36'><rect x='0.5' y='0.5' width='83' height='35' rx='17.5' fill='#1c2129' stroke='#2d3442'/></svg>", 84, 36)
                      Center { Text("参照...", size: 12).weight(medium) }
                    } }
                }
                Caption("指定した場所にプロジェクトを保存します。")
              }

              Surface(padding: 0, spacing: 0, radius: 0, border: false, background: "#212733") { Spacer }.frame(height: 1)

              VStack(spacing: 4) {
                Checkbox("最初のコンポジションを作成", setup_create_initial_comp, action: setup_create_initial_comp_changed)
                Padding(horizontal: 26, vertical: 0) {
                  Caption("プロジェクト作成時に編集用のコンポジションも用意します。")
                }
              }

              If(setup_create_initial_comp) {
                Card(padding: 16, spacing: 12, hover_strength: 0.0, hover_elevation: 0.0) {
                  VStack(spacing: 8) {
                    Text("コンポジション名", size: 13).weight(medium)
                    TextField(setup_comp_name, "コンポジション 1", action: setup_comp_name_changed)
                  }
                  VStack(spacing: 8) {
                    Text("プリセット", size: 13).weight(medium)
                    Select(setup_preset, action: setup_preset_changed) {
                      Option("full_hd", "フルHD · 1920×1080 · 60fps")
                      Option("4k", "4K · 3840×2160 · 24fps")
                      Option("vertical", "縦型 · 1080×1920 · 60fps")
                      Option("square", "正方形 · 1080×1080 · 30fps")
                      Option("custom", "カスタム")
                    }
                  }
                  HitArea("setup_toggle_advanced", action: setup_toggle_advanced) { HStack(spacing: 6) {
                      If(setup_advanced_open) {
                        Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#8d95a2' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m6 9 6 6 6-6'/></svg>", 14, 14)
                      } else {
                        Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#8d95a2' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m9 18 6-6-6-6'/></svg>", 14, 14)
                      }
                      Text("詳細設定", size: 13).weight(medium)
                      Spacer
                    } }
                  If(setup_advanced_open) {
                    VStack(spacing: 12) {
                      HStack(spacing: 8) {
                        Caption("幅")
                        MaxWidth(120) { TextField(setup_width, "1920", action: setup_width_changed) }
                        Caption("×")
                        MaxWidth(120) { TextField(setup_height, "1080", action: setup_height_changed) }
                        Caption("px")
                        Spacer
                      }
                      HStack(spacing: 10) {
                        Caption("フレームレート")
                        MaxWidth(100) { TextField(setup_fps, "60", action: setup_fps_changed) }
                        Caption("fps")
                        Spacer
                        Caption("長さ")
                        MaxWidth(100) { TextField(setup_duration_seconds, "10", action: setup_duration_changed) }
                        Caption("秒")
                      }
                    }
                  }
                }
              }

              If(setup_error != "") { Caption("{setup_error}") }

              HStack(spacing: 10) {
                Spacer
                HitArea("setup_cancel", action: setup_cancel) { ZStack {
                    Svg("<svg xmlns='http://www.w3.org/2000/svg' width='112' height='36' viewBox='0 0 112 36'><rect x='0.5' y='0.5' width='111' height='35' rx='17.5' fill='#1c2129' stroke='#2d3442'/></svg>", 112, 36)
                    Center { Text("キャンセル", size: 13).weight(medium) }
                  } }
                HitArea("setup_create", action: setup_create) { ZStack {
                    Svg("<svg xmlns='http://www.w3.org/2000/svg' width='156' height='36' viewBox='0 0 156 36'><rect x='0.5' y='0.5' width='155' height='35' rx='17.5' fill='#262d38' stroke='#3a4454'/></svg>", 156, 36)
                    Center { Text("プロジェクトを作成", size: 13).weight(semibold) }
                  } }
              }
            }
          }
        }
      }
    }
  }
