component CommandPaletteModal() {
    Card {
      VStack(spacing: 12) {
        Surface(padding: 6, spacing: 0, radius: 5, border: false, background: "#14181f") {
          HStack(spacing: 8) {
            Text("Command Palette")
              .font_size(14)
              .weight(semibold)
            Spacer
            Surface(padding: 2, spacing: 0, radius: 4, border: false, background: "#1b202b") {
              Button("Esc", action: toggle_command_palette, tone: ghost, size: small)
            }
          }
        }
        CommandPalette(action: execute_command, placeholder: "Search commands, tools, workspaces...") {
          Command("tool_select", "Tool: Select", hint: "V")
          Command("tool_hand", "Tool: Hand", hint: "H")
          Command("tool_zoom", "Tool: Zoom", hint: "Z")
          Command("tool_text", "Tool: Text", hint: "T")
          Command("tool_shape", "Tool: Shape", hint: "Q")
          Command("tool_pen", "Tool: Pen", hint: "G")
          Command("tool_roto", "Tool: Roto Brush", hint: "R")
          Command("workspace_default", "Workspace: Default")
          Command("workspace_color", "Workspace: Color & LUT")
          Command("workspace_effects", "Workspace: Effects")
          Command("workspace_camera_light", "Workspace: 3D Camera & Light")
          Command("workspace_layer_style", "Workspace: Layer Styles")
          Command("workspace_composition", "Workspace: Composition")
          Command("workspace_timeline", "Workspace: Timeline")
          Command("workspace_animation", "Workspace: Animation")
          Command("workspace_graph", "Workspace: Graph Editor")
        }
      }
      .padding(16)
      .frame(width: 560, height: 360)
    }
    .pointer_lighting()
  }
