component SettingsPerformancePage() {
  VStack(spacing: 12) {
    VStack(spacing: 4) { Title("パフォーマンス") Caption("メモリの使用方法や処理の設定を調整します。") }

    Card(padding: 12, spacing: 10, hover_strength: 0.0, hover_elevation: 0.0) {
      Text("エフェクト計算", size: 13)
      SettingsRow("GPU計算", label_width: 170) {
        Select(renderer, action: setting_renderer_changed) {
          Option("gpu", "GPU（対応エフェクトのみ）")
          Option("cpu", "CPU（標準）")
        }
      }
      Caption("対応エフェクト・ブレンドおよび書き出しで GPU を優先使用し、非対応機能は CPU にフォールバックします。")
      SettingsRow("総メモリ上限", label_width: 170) {
        HStack(spacing: 6) { DragValue(memory_limit_gb, min: 1.0, max: 64.0, action: setting_memory_changed) Caption("GB") }
      }
      Checkbox("再生中の解像度自動低下（アダプティブプレビュー）", adaptive_preview, action: setting_adaptive_preview_changed)
      Caption("総メモリ上限とアイドル時の事前レンダーがプレビュー RAM キャッシュに連動します。")
    }

    Card(padding: 12, spacing: 10, hover_strength: 0.0, hover_elevation: 0.0) {
      Text("キャッシュ", size: 13)
      SettingsRow("ディスクキャッシュの場所", label_width: 200) {
        AttachedButton("参照…", action: setting_cache_path_browse) {
          TextField(cache_path, "キャッシュ保存先", action: setting_cache_path_changed)
        }
      }
      If(cache_path_status != "") { Caption("{cache_path_status}") }
      HStack(spacing: 8) {
        Caption("使用量")
        Spacer
        Card(padding: 4, spacing: 0, hover_strength: 0.0, hover_elevation: 0.0) { Caption("{cache_usage_text} / {cache_limit} GB") }
      }
      ProgressBar(cache_usage_progress)
      HStack(spacing: 8) {
        Caption("最大サイズ（10〜500 GB）")
        MaxWidth(80) { TextField(cache_limit, "GB", action: setting_cache_limit_changed) }
        Caption("GB")
        Spacer
        Button("キャッシュを削除", action: clear_cache, tone: secondary, size: small)
      }
    }

    Card(padding: 12, spacing: 10, hover_strength: 0.0, hover_elevation: 0.0) {
      Text("履歴と復旧", size: 13)
      SettingsRow("Undo 履歴", label_width: 170) {
        HStack(spacing: 6) { DragValue(undo_steps, min: 10.0, max: 500.0, action: setting_undo_changed) Caption("件") }
      }
      SettingsRow("自動復旧スロット", label_width: 170) {
        HStack(spacing: 6) { DragValue(recovery_slots, min: 1.0, max: 50.0, action: setting_recovery_changed) Caption("個") }
      }
    }

    If(clear_cache_confirm) {
      Card(padding: 14, spacing: 10, hover_strength: 0.0, hover_elevation: 0.0) {
        Text("キャッシュを消去しますか？", size: 17)
        Caption("プレビューキャッシュのみを削除します。プロジェクトや素材ファイルは削除されません。")
        HStack(spacing: 8) {
          Spacer
          Button("キャンセル", action: dismiss_clear_cache, tone: secondary)
          Button("消去", action: confirm_clear_cache, tone: destructive)
        }
      }
    }
  }
}
