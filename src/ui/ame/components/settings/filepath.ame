component SettingsFilepathPage() {
  VStack(spacing: 12) {
    VStack(spacing: 4) { Title("ファイルパス") Caption("プロジェクト、キャッシュ、メディアなどの保存先を設定します。") }

    Card(padding: 12, spacing: 10, hover_strength: 0.0, hover_elevation: 0.0) {
      Text("プロジェクト", size: 13)
      SettingsRow("プロジェクトの保存先", label_width: 170) {
        AttachedButton("参照…", action: setting_project_dir_browse) {
          TextField(project_dir, "プロジェクトフォルダ", action: setting_project_dir_changed)
        }
      }
      SettingsRow("自動命名", label_width: 170) {
        Checkbox("新しいプロジェクトに自動で名前を付ける", auto_project_names, action: setting_auto_project_names_changed)
      }
    }

    Card(padding: 12, spacing: 10, hover_strength: 0.0, hover_elevation: 0.0) {
      Text("キャッシュ・一時ファイル", size: 13)
      SettingsRow("メディアキャッシュ", label_width: 170) {
        AttachedButton("参照…", action: setting_cache_path_browse) {
          TextField(cache_path, "メディアキャッシュ", action: setting_cache_path_changed)
        }
      }
      SettingsRow("プレビューキャッシュ", label_width: 170) {
        AttachedButton("参照…", action: setting_preview_cache_browse) {
          TextField(preview_cache_dir, "プレビューキャッシュ", action: setting_preview_cache_changed)
        }
      }
      SettingsRow("一時ファイル", label_width: 170) {
        AttachedButton("参照…", action: setting_temp_dir_browse) {
          TextField(temp_dir, "一時ファイル", action: setting_temp_dir_changed)
        }
      }
    }

    Card(padding: 12, spacing: 10, hover_strength: 0.0, hover_elevation: 0.0) {
      Text("自動保存・バックアップ", size: 13)
      SettingsRow("自動保存の保存先", label_width: 170) {
        AttachedButton("参照…", action: setting_autosave_dir_browse) {
          TextField(autosave_dir, "自動保存", action: setting_autosave_dir_changed)
        }
      }
      SettingsRow("自動保存の間隔", label_width: 170) {
        Select(autosave_interval, action: setting_autosave_interval_changed) {
          Option("0", "無効")
          Option("30", "30秒")
          Option("60", "1分")
          Option("180", "3分")
          Option("300", "5分")
          Option("600", "10分")
          Option("900", "15分")
          Option("1800", "30分")
        }
      }
      SettingsRow("バックアップの保存先", label_width: 170) {
        AttachedButton("参照…", action: setting_backup_dir_browse) {
          TextField(backup_dir, "バックアップ", action: setting_backup_dir_changed)
        }
      }
      SettingsRow("バックアップの世代数", label_width: 170) {
        HStack(spacing: 6) { DragValue(backup_generations, min: 1.0, max: 100.0, action: setting_backup_generations_changed) Caption("世代") }
      }
    }

    Card(padding: 12, spacing: 10, hover_strength: 0.0, hover_elevation: 0.0) {
      Text("アセットライブラリ", size: 13)
      SettingsRow("ユーザーアセットの保存先", label_width: 190) {
        AttachedButton("参照…", action: setting_asset_library_browse) {
          TextField(asset_library_dir, "アセットライブラリ", action: setting_asset_library_changed)
        }
      }
    }
  }
}
