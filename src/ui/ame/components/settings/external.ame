component SettingsExternalPage() {
  VStack(spacing: 12) {
    VStack(spacing: 4) { Title("外部連携") Caption("OpenFX バンドルの検出状況を確認します。") }

    Card(padding: 12, spacing: 10) {
      HStack(spacing: 8) {
        Text("OpenFX", size: 13)
        Spacer
        Caption("検出のみ")
        Button("再スキャン", action: settings_plugins_refresh, tone: secondary, size: small)
      }
      If(has_openfx_plugins) {
        ForEach(openfx_plugins, plugin, key: path) {
          Card(padding: 10, spacing: 4) {
            Text("{plugin.name}", size: 13)
            Caption("{plugin.path}")
          }
        }
      } else {
        Caption("対応する場所に OpenFX プラグインは見つかりませんでした。")
      }
      Caption("エフェクトの読み込み・実行は未対応です。")
      Caption("AEGP ホスト連携は未実装です。")
    }

    Card(padding: 12, spacing: 10) {
      Text("検索場所", size: 13)
      If(openfx_search_paths != "") { Caption("{openfx_search_paths}") } else { Caption("標準の OpenFX 検索フォルダが見つかりません。") }
    }
  }
}
