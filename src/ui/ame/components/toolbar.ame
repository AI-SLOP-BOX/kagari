component ToolBar() {
    Card {
      Padding(horizontal: 6, vertical: 4) {
        VStack(spacing: 4) {
        HStack(spacing: 8) {
          HStack(spacing: 2) {
            If(selected_tool == "Selection") { Button("選択", action: tool_select, tone: primary, size: small) } else { Button("選択", action: tool_select, tone: secondary, size: small) }
            If(selected_tool == "Hand") { Button("手", action: tool_hand, tone: primary, size: small) } else { Button("手", action: tool_hand, tone: secondary, size: small) }
            If(selected_tool == "Zoom") { Button("ズーム", action: tool_zoom, tone: primary, size: small) } else { Button("ズーム", action: tool_zoom, tone: secondary, size: small) }
            IconButton("type", action: tool_text, tone: secondary, size: small)
            IconButton("shape", action: tool_shape, tone: secondary, size: small)
            IconButton("edit", action: tool_pen, tone: secondary, size: small)
            If(selected_tool_roto) { Button("ロト", action: tool_roto, tone: primary, size: small) } else { Button("ロト", action: tool_roto, tone: secondary, size: small) }
          }
          Spacer
          HStack(spacing: 6) {
            If(compact) { IconButton("undo", action: undo_project, tone: secondary, size: small, disabled: !can_undo) } else { Button("戻す", action: undo_project, tone: secondary, size: small, disabled: !can_undo) }
            If(compact) { IconButton("redo", action: redo_project, tone: secondary, size: small, disabled: !can_redo) } else { Button("やり直す", action: redo_project, tone: secondary, size: small, disabled: !can_redo) }
            If(compact) { IconButton("effect", action: add_adjustment_layer, tone: secondary, size: small) } else { Button("調整", action: add_adjustment_layer, tone: secondary, size: small) }
            If(compact) { IconButton("particle", action: add_particle_layer, tone: secondary, size: small) } else { Button("粒子", action: add_particle_layer, tone: secondary, size: small) }
            Caption("{selected_tool_label}ツール")
            If(roto_analysis_busy) { Button("ロト処理を中止", action: roto_cancel, tone: secondary, size: small) }
          }
          Spacer
          If(compact) { HorizontalScrollView(220) { WorkspaceTabs() } } else { HorizontalScrollView(480) { WorkspaceTabs() } }
          Spacer
          HStack(spacing: 4) {
            If(is_playing) { IconButton("pause", action: play_toggle, tone: primary, size: small) } else { IconButton("play", action: play_toggle, tone: secondary, size: small) }
            If(playback_loop) { IconButton("repeat", action: toggle_playback_loop, tone: primary, size: small) } else { IconButton("repeat", action: toggle_playback_loop, tone: secondary, size: small) }
            IconButton("stop", action: play_stop, tone: secondary, size: small)
          }
        }
        If(selected_tool_roto) {
          HStack(spacing: 8) {
            If(roto_foreground) { Button("前景", action: roto_mode_foreground, tone: primary, size: small) } else { Button("前景", action: roto_mode_foreground, tone: secondary, size: small) }
            If(roto_foreground) { Button("背景 (Alt)", action: roto_mode_background, tone: secondary, size: small) } else { Button("背景 (Alt)", action: roto_mode_background, tone: primary, size: small) }
            Caption("ブラシ")
            Slider(roto_brush_radius, min: 1.0, max: 128.0, action: roto_brush_radius_changed)
            Caption("ぼかし")
            Slider(roto_feather_radius, min: 0.0, max: 32.0, action: roto_feather_radius_changed)
            Button("消去", action: roto_clear, tone: secondary, size: small, disabled: roto_analysis_busy)
            Button("時間方向へ伝播", action: roto_propagate, tone: secondary, size: small, disabled: roto_analysis_busy)
            Caption("{roto_status}")
          }
        }
      }
    }
    }
  }

component WorkspaceTabs() {
  HStack(spacing: 2) {
    Button("標準", action: workspace_default, tone: secondary, size: small)
    Button("タイムライン", action: workspace_timeline, tone: secondary, size: small)
    Button("グラフ", action: workspace_graph, tone: secondary, size: small)
    Button("エフェクト", action: workspace_effects, tone: secondary, size: small)
    Button("3D・照明", action: workspace_camera_light, tone: secondary, size: small)
    Button("色補正", action: workspace_color, tone: secondary, size: small)
    Button("合成", action: workspace_layer_style, tone: secondary, size: small)
    Button("マスク", action: workspace_mask, tone: secondary, size: small)
    Button("文字", action: workspace_text, tone: secondary, size: small)
    Button("音響", action: workspace_audio, tone: secondary, size: small)
    Button("リマップ", action: workspace_time_remap, tone: secondary, size: small)
    IconButton("reset", action: workspace_reset_layout, tone: secondary, size: small)
  }
}
