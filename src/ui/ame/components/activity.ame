component ActivityPanel() {
    HStack(spacing: 0) {
      Align(stretch) { HomeNavRail() }
      Grow(1) {
        ScrollView(2400) {
          Padding(horizontal: 24, vertical: 16) {
            VStack(spacing: 14) {
              HStack(spacing: 10) {
                VStack(spacing: 3) {
                  Text("更新履歴", size: 22).weight(bold)
                  Caption("プロジェクトファイルの更新日時を新しい順に表示します。")
                }
                Spacer
                Button("ホームへ", action: go_home, tone: secondary, size: small)
              }
              ForEach(recent_project_items, project, key: path) {
                Card(padding: 12, spacing: 0) {
                  HStack(spacing: 12) {
                    AssetImage("kagari.nav.documents", 1, 16, 16)
                    VStack(spacing: 4) {
                      Text("{project.name} を更新しました", size: 14).weight(semibold)
                      HStack(spacing: 8) {
                        Card(padding: 3, spacing: 0, hover_strength: 0.0, hover_elevation: 0.0) { Caption("{project.specs}") }
                        Caption("{project.info}")
                      }
                      Caption("{project.location}")
                    }
                    Spacer
                    Caption("{project.date}")
                    Button("開く  →", action: open_recent_project, tone: secondary, size: small)
                  }
                }
              }
              If(!has_recents) {
                Card(padding: 18, spacing: 8, hover_strength: 0.0, hover_elevation: 0.0) {
                  Text("更新履歴はありません", size: 16).weight(semibold)
                  Caption("プロジェクトを保存すると、ファイルの更新日時がここに表示されます。")
                  Button("プロジェクトを開く", action: open_project, tone: primary, size: small)
                }
              }
            }
          }
        }
      }
    }
  }
