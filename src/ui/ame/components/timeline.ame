component TimelineRows() {
  HStack(spacing: 3) {
    MinWidth(296) { VStack(spacing: 2) {
      Surface(padding: 3, spacing: 0, radius: 4, border: false, background: "#141820") {
        HStack(spacing: 2) {
          Caption("レイヤー").frame(width: 120)
          Caption("モード").frame(width: 52)
          Caption("マット").frame(width: 44)
          Spacer
          Caption("スイッチ")
        }
      }.frame(height: 24)
      ForEach(timeline_layers, layer, key: id, height: 420, row_height: 28, overscan: 8) {
        HStack(spacing: 2) {
          Caption("{layer.indent}")
          If(layer.has_children) { If(layer.collapsed) { IconButton("chevron_right", action: toggle_scene_group, tone: ghost, size: small) } else { IconButton("chevron_down", action: toggle_scene_group, tone: ghost, size: small) } } else { Icon("tree_branch", 12) }
          MaxWidth(116) { If(layer.selected) { Button("{layer.name}", action: select_layer, tone: primary, size: small) } else { Button("{layer.name}", action: select_layer, tone: ghost, size: small) } }
          Surface(padding: 1, spacing: 0, radius: 4, border: false, background: "#181d26") {
            Button("{layer.blend_mode}", action: cycle_layer_blend_mode, tone: ghost, size: small)
          }
          Surface(padding: 1, spacing: 0, radius: 4, border: false, background: "#181d26") {
            Button("{layer.track_matte}", action: cycle_layer_track_matte, tone: ghost, size: small)
          }
          Spacer
          If(layer.visible) { IconButton("eye", action: toggle_layer_visibility, tone: ghost, size: small) } else { IconButton("eye_off", action: toggle_layer_visibility, tone: primary, size: small) }
          If(layer.locked) { IconButton("lock", action: toggle_layer_lock, tone: primary, size: small) } else { IconButton("unlock", action: toggle_layer_lock, tone: ghost, size: small) }
          If(layer.solo) { Button("S", action: toggle_layer_solo, tone: primary, size: small) } else { Button("S", action: toggle_layer_solo, tone: ghost, size: small) }
          If(layer.has_audio) { If(layer.audio_muted) { Button("M", action: toggle_audio_mute, tone: primary, size: small) } else { Button("M", action: toggle_audio_mute, tone: ghost, size: small) } }
        }.frame(height: 28).context_menu() {
          Item("レイヤー複製 (Cmd+D)", action: duplicate_selected_layer)
          Item("再生位置で分割 (Cmd+Shift+D)", action: split_selected_layer_at_playhead)
          Item("イン点を再生位置へ ([)", action: set_selected_layer_in_to_playhead)
          Item("アウト点を再生位置へ (])", action: set_selected_layer_out_to_playhead)
          Item("レイヤー削除 (Delete)", action: request_remove_selected_layer)
        }
      }
      If(!has_timeline_layers) { Caption("該当レイヤーなし").frame(height: 28) }
    } }
    Grow(1) { Canvas("kagari.timeline").frame(height: 420) }
  }
}

component TimelineTransport() {
  Wrap(item_spacing: 2, line_spacing: 2) {
    IconButton("rewind", action: play_rewind, tone: ghost, size: small)
    IconButton("step_prev", action: step_frame_backward, tone: ghost, size: small)
    If(is_playing) { IconButton("pause", action: play_toggle, tone: primary, size: small) } else { IconButton("play", action: play_toggle, tone: ghost, size: small) }
    IconButton("step_next", action: step_frame_forward, tone: ghost, size: small)
    If(playback_loop) { IconButton("repeat", action: toggle_playback_loop, tone: primary, size: small) } else { IconButton("repeat", action: toggle_playback_loop, tone: ghost, size: small) }
    IconButton("fast_forward", action: play_forward, tone: ghost, size: small)
  }
}

component CompactTimelineControls() {
  Wrap(item_spacing: 2, line_spacing: 2) {
    IconButton("rewind", action: play_rewind, tone: ghost, size: small)
    IconButton("step_prev", action: step_frame_backward, tone: ghost, size: small)
    If(is_playing) { IconButton("pause", action: play_toggle, tone: primary, size: small) } else { IconButton("play", action: play_toggle, tone: ghost, size: small) }
    IconButton("step_next", action: step_frame_forward, tone: ghost, size: small)
    If(playback_loop) { IconButton("repeat", action: toggle_playback_loop, tone: primary, size: small) } else { IconButton("repeat", action: toggle_playback_loop, tone: ghost, size: small) }
    IconButton("fast_forward", action: play_forward, tone: ghost, size: small)
    MinWidth(112) { TextField(current_time, "00:00:02:12", action: time_changed) }
    Button("キー", action: add_keyframe, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
    Button("イーズ (F9)", action: ease_selected_layer, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
    KeyframeNavigation()
    Caption("{fps_label}")
  }
}

component KeyframeNavigation() {
  HStack(spacing: 2) {
    IconButton("step_prev", action: previous_keyframe, tone: ghost, size: small)
    IconButton("step_next", action: next_keyframe, tone: ghost, size: small)
    Caption("{keyframe_status}")
  }
}

component TimelineRuler() {
  HStack(spacing: 3) {
    MinWidth(212) { Caption("時間") }
    Grow(1) {
      HStack(spacing: 0) {
        Caption("{timeline_time_0}")
        Spacer
        Caption("{timeline_time_1}")
        Spacer
        Caption("{timeline_time_2}")
        Spacer
        Caption("{timeline_time_3}")
        Spacer
        Caption("{timeline_time_4}")
        Spacer
        Caption("{timeline_time_5}")
      }
    }
  }
}

component TimelinePanel() {
    Card(padding: 6, spacing: 4, hover_strength: 0.0, hover_elevation: 0.0) {
      VStack(spacing: 4) {
          If(wide) {
            VStack(spacing: 4) {
              HStack(spacing: 6) {
                If(is_audio_workspace) { MinWidth(120) { Text("オーディオタイムライン", size: 13).weight(bold) } } else { MinWidth(84) { Text("タイムライン", size: 13).weight(bold) } }
                Grow(1) { HorizontalScrollView(420) { HStack(spacing: 2) {
                  If(timeline_view_all) { Button("すべて", action: timeline_view_all, tone: primary, size: small) } else { Button("すべて", action: timeline_view_all, tone: ghost, size: small) }
                  If(timeline_view_animation) { Button("アニメーション", action: timeline_view_animation, tone: primary, size: small) } else { Button("アニメーション", action: timeline_view_animation, tone: ghost, size: small) }
                  If(timeline_view_current_keyframes) { Button("現在位置のキー", action: timeline_view_current_keyframes, tone: primary, size: small) } else { Button("現在位置のキー", action: timeline_view_current_keyframes, tone: ghost, size: small) }
                  If(timeline_view_audio) { Button("音声", action: timeline_view_audio, tone: primary, size: small) } else { Button("音声", action: timeline_view_audio, tone: ghost, size: small) }
                  If(timeline_view_media) { Button("メディア", action: timeline_view_media, tone: primary, size: small) } else { Button("メディア", action: timeline_view_media, tone: ghost, size: small) }
                  If(timeline_view_text) { Button("文字", action: timeline_view_text, tone: primary, size: small) } else { Button("文字", action: timeline_view_text, tone: ghost, size: small) }
                  If(timeline_view_shapes) { Button("図形", action: timeline_view_shapes, tone: primary, size: small) } else { Button("図形", action: timeline_view_shapes, tone: ghost, size: small) }
                  If(timeline_view_3d) { Button("3D", action: timeline_view_3d, tone: primary, size: small) } else { Button("3D", action: timeline_view_3d, tone: ghost, size: small) }
                  If(timeline_view_cameras) { Button("カメラ", action: timeline_view_cameras, tone: primary, size: small) } else { Button("カメラ", action: timeline_view_cameras, tone: ghost, size: small) }
                  If(timeline_view_lights) { Button("ライト", action: timeline_view_lights, tone: primary, size: small) } else { Button("ライト", action: timeline_view_lights, tone: ghost, size: small) }
                  If(timeline_view_graph) { Button("グラフ", action: timeline_view_graph, tone: primary, size: small) } else { Button("グラフ", action: timeline_view_graph, tone: ghost, size: small) }
                  If(timeline_view_flowchart) { Button("ノード", action: timeline_view_flowchart, tone: primary, size: small) } else { Button("ノード", action: timeline_view_flowchart, tone: ghost, size: small) }
                } } }
                MaxWidth(110) { TextField(current_time, "00:00:02:12", action: time_changed) }
                Caption("{fps_label}")
                Button("書き出し", action: go_export, tone: ghost, size: small)
              }
              Wrap(item_spacing: 6, line_spacing: 4) {
                TimelineTransport()
                If(hide_shy_layers) { Button("シャイ", action: toggle_shy_visibility, tone: primary, size: small) } else { Button("シャイ", action: toggle_shy_visibility, tone: ghost, size: small) }
                Button("キー追加", action: add_keyframe, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
                Button("イージーイーズ (F9)", action: ease_selected_layer, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
                KeyframeNavigation()
              }
            }
          } else {
            HStack(spacing: 5) {
              If(is_audio_workspace) { Text("オーディオ", size: 13) } else { Text("タイムライン", size: 13) }
              HorizontalScrollView(290) { HStack(spacing: 2) {
                If(timeline_view_all) { Button("全", action: timeline_view_all, tone: primary, size: small) } else { Button("全", action: timeline_view_all, tone: ghost, size: small) }
                If(timeline_view_animation) { Button("動", action: timeline_view_animation, tone: primary, size: small) } else { Button("動", action: timeline_view_animation, tone: ghost, size: small) }
                If(timeline_view_current_keyframes) { Button("現キー", action: timeline_view_current_keyframes, tone: primary, size: small) } else { Button("現キー", action: timeline_view_current_keyframes, tone: ghost, size: small) }
                If(timeline_view_audio) { Button("音", action: timeline_view_audio, tone: primary, size: small) } else { Button("音", action: timeline_view_audio, tone: ghost, size: small) }
                If(timeline_view_media) { Button("映", action: timeline_view_media, tone: primary, size: small) } else { Button("映", action: timeline_view_media, tone: ghost, size: small) }
                If(timeline_view_text) { Button("文", action: timeline_view_text, tone: primary, size: small) } else { Button("文", action: timeline_view_text, tone: ghost, size: small) }
                If(timeline_view_shapes) { Button("図", action: timeline_view_shapes, tone: primary, size: small) } else { Button("図", action: timeline_view_shapes, tone: ghost, size: small) }
                If(timeline_view_3d) { Button("3D", action: timeline_view_3d, tone: primary, size: small) } else { Button("3D", action: timeline_view_3d, tone: ghost, size: small) }
                If(timeline_view_cameras) { Button("C", action: timeline_view_cameras, tone: primary, size: small) } else { Button("C", action: timeline_view_cameras, tone: ghost, size: small) }
                If(timeline_view_lights) { Button("L", action: timeline_view_lights, tone: primary, size: small) } else { Button("L", action: timeline_view_lights, tone: ghost, size: small) }
                If(timeline_view_graph) { Button("曲", action: timeline_view_graph, tone: primary, size: small) } else { Button("曲", action: timeline_view_graph, tone: ghost, size: small) }
                If(timeline_view_flowchart) { Button("節", action: timeline_view_flowchart, tone: primary, size: small) } else { Button("節", action: timeline_view_flowchart, tone: ghost, size: small) }
              } }
              If(hide_shy_layers) { Button("SH", action: toggle_shy_visibility, tone: primary, size: small) } else { Button("SH", action: toggle_shy_visibility, tone: ghost, size: small) }
              Spacer
            }
          }
          If(!timeline_view_flowchart) {
            If(!wide) { CompactTimelineControls() }
            If(wide) {
            Wrap(item_spacing: 3, line_spacing: 3) {
              Caption("時間範囲")
              IconButton("minus", action: timeline_zoom_out, tone: ghost, size: small)
              Caption("{timeline_zoom_label}")
              IconButton("add", action: timeline_zoom_in, tone: ghost, size: small)
              Button("全体", action: timeline_zoom_fit, tone: ghost, size: small)
              Button("分割", action: split_selected_layer_at_playhead, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
              Button("Inへ", action: layer_in_to_playhead, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
              Button("Outへ", action: layer_out_to_playhead, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
              IconButton("arrow_up", action: move_layer_up, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
              IconButton("arrow_down", action: move_layer_down, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
              Button("先頭", action: move_layer_to_start, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
              Button("末尾", action: move_layer_to_end, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
              IconButton("arrow_left", action: timeline_pan_left, tone: ghost, size: small)
              IconButton("arrow_right", action: timeline_pan_right, tone: ghost, size: small)
              If(timeline_view_markers) { Button("マーカー", action: timeline_view_markers, tone: primary, size: small) } else { Button("マーカー", action: timeline_view_markers, tone: ghost, size: small) }
              If(timeline_snap_enabled) { IconButton("magnet", action: toggle_timeline_snap, tone: primary, size: small) } else { IconButton("magnet", action: toggle_timeline_snap, tone: ghost, size: small) }
            }
          } else {
            Wrap(item_spacing: 3, line_spacing: 3) {
              IconButton("minus", action: timeline_zoom_out, tone: ghost, size: small)
              Caption("{timeline_zoom_label}")
              IconButton("add", action: timeline_zoom_in, tone: ghost, size: small)
              Button("全体", action: timeline_zoom_fit, tone: ghost, size: small)
              Button("分割", action: split_selected_layer_at_playhead, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
              Button("イン", action: layer_in_to_playhead, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
              Button("アウト", action: layer_out_to_playhead, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
              IconButton("arrow_up", action: move_layer_up, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
              IconButton("arrow_down", action: move_layer_down, tone: ghost, size: small, disabled: !selected_layer || selected_layer_locked)
              If(timeline_view_markers) { Button("マーカー", action: timeline_view_markers, tone: primary, size: small) } else { Button("マーカー", action: timeline_view_markers, tone: ghost, size: small) }
              If(timeline_snap_enabled) { IconButton("magnet", action: toggle_timeline_snap, tone: primary, size: small) } else { IconButton("magnet", action: toggle_timeline_snap, tone: ghost, size: small) }
            }
          }
          If(wide) {
            HStack(spacing: 4) {
              Caption("再生範囲")
              Caption("開始f")
              MaxWidth(70) { TextField(work_area_start_frame, "0", action: work_area_start_frame_changed) }
              Button("現在位置", action: set_playback_range_start, tone: ghost, size: small)
              Caption("終了f")
              MaxWidth(70) { TextField(work_area_end_frame, "0", action: work_area_end_frame_changed) }
              Button("現在位置", action: set_playback_range_end, tone: ghost, size: small)
              Caption("{work_area_label}")
              Button("解除", action: clear_playback_range, tone: ghost, size: small)
            }
          } else {
            HStack(spacing: 3) {
              Caption("範囲")
              Caption("開始")
              MaxWidth(48) { TextField(work_area_start_frame, "0", action: work_area_start_frame_changed) }
              Button("現在位置", action: set_playback_range_start, tone: ghost, size: small)
              Caption("終了")
              MaxWidth(48) { TextField(work_area_end_frame, "0", action: work_area_end_frame_changed) }
              Button("現在位置", action: set_playback_range_end, tone: ghost, size: small)
                Button("解除", action: clear_playback_range, tone: ghost, size: small)
                Spacer
              }
            }
          }
          If(timeline_view_current_keyframes) { Caption("{current_time} にキーフレームがあるレイヤー") }
          If(timeline_view_graph) {
            GraphEditorPanel()
          } else {
            If(timeline_view_flowchart) {
              FlowchartPanel()
            } else {
              If(wide) { TimelineRuler() }
              ScrollView(600) { TimelineRows() }
              TimelineMarkers()
              If(timeline_view_markers) { LayerMarkerTrackList() }
            }
          }
        }
        .context_menu() {
          Item("コマンドパレット", action: toggle_command_palette)
          Item("再生範囲を解除", action: clear_playback_range)
        }
      }
  }
