component HomeHero() {
    VStack(spacing: 12) {
      AssetImage("kagari.logo", 1, 72, 72)
      Text("Kagari", size: 32).weight(bold)
      Caption("VFX・コンポジット・モーショングラフィックスの制作を始めましょう。")
      HStack(spacing: 14) {
        HeroNewProjectAction()
        HeroOpenProjectAction()
      }
      Button("ドキュメントを見る  →", action: go_documents, tone: secondary, size: small)
    }
  }

component HeroNewProjectAction() {
    ZStack {
      Svg("<svg xmlns='http://www.w3.org/2000/svg' width='171' height='38' viewBox='0 0 171 38'><rect x='.5' y='.5' width='170' height='37' rx='9' fill='#f58c4b'/></svg>", 171, 38)
      Center {
        HStack(spacing: 8) {
          Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#11161a' stroke-width='2.4' stroke-linecap='round'><path d='M12 5v14M5 12h14'/></svg>", 16, 16)
          Text("新規プロジェクト", size: 14).weight(bold)
        }
      }
      Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("", action: new_project, tone: secondary).opacity(nav_hitbox_opacity) }}
  }

component HeroOpenProjectAction() {
    ZStack {
      Svg("<svg xmlns='http://www.w3.org/2000/svg' width='176' height='38' viewBox='0 0 176 38'><rect x='.5' y='.5' width='175' height='37' rx='9' fill='#0d1215' stroke='#30363c'/></svg>", 176, 38)
      Center {
        HStack(spacing: 8) {
          Svg("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#d8dee4' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'><path d='M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/></svg>", 16, 16)
          Text("プロジェクトを開く", size: 14)
        }
      }
      Positioned(left: 0, right: 0, top: 0, bottom: 0) { Button("", action: open_project, tone: secondary).opacity(nav_hitbox_opacity) }}
  }

component RecentCardsGrid() {
    VStack(spacing: 10) {
      HStack(spacing: 8) {
        Text("最近のプロジェクト", size: 20)
        Spacer
        Button("すべて表示  →", action: go_projects, tone: secondary, size: small)
      }
      If(has_recent_1) {
        MaxWidth(1200) {
          Card {
            HStack(spacing: 0) {
              ZStack {
                Svg("<svg xmlns='http://www.w3.org/2000/svg' width='300' height='169' viewBox='0 0 300 169'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0%' stop-color='#192027'/><stop offset='100%' stop-color='#0e1318'/></linearGradient></defs><rect width='300' height='169' fill='url(#g)'/><g transform='translate(132,66)' fill='none' stroke='#3e4a56' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='4' width='32' height='24' rx='3'/><path d='M10 4v24M26 4v24M2 12h8M2 20h8M26 12h8M26 20h8'/></g></svg>", 300, 169)
                AssetImage("kagari.home.recent.1", 1, 300, 169)
                Svg("<svg xmlns='http://www.w3.org/2000/svg' width='300' height='169' viewBox='0 0 300 169'><path d='M0 0H14A14 14 0 0 0 0 14Z M286 0H300V14A14 14 0 0 0 286 0Z M0 155V169H14A14 14 0 0 0 0 155Z M286 155V169H272A14 14 0 0 0 286 155Z' fill='#11161a'/></svg>", 300, 169)
              }
              Grow(1) {
                Padding(18) {
                  VStack(spacing: 10) {
                    Text("{recent_1_name}", size: 18)
                    Caption("{recent_1_path}")
                    Spacer
                    HStack(spacing: 6) { AssetImage("kagari.nav.projects", 1, 14, 14) Text("{recent_1_res}  ·  {recent_1_layers}レイヤー", size: 11) Spacer }
                    Text("最終更新  {recent_1_date}", size: 11)
                  }
                }
              }
              Padding(16) { Button("開く  →", action: open_recent_1, tone: primary, size: small) }
            }
          }
        }
      } else {
        Card { Padding(14) { HStack(spacing: 8) { Caption("最近使ったプロジェクトはありません") Spacer Button("プロジェクトを開く", action: open_project, tone: secondary, size: small) } } }
      }
    }
  }

component RecentWorkTable() {
    VStack(spacing: 8) {
      HStack(spacing: 8) {
        Text("最近の更新", size: 20)
        Spacer
        Button("更新履歴を見る  →", action: go_activity, tone: secondary, size: small)
      }
      If(compact) {
        If(has_recents) {
          VStack(spacing: 6) {
            ForEach(recent_project_items, project, key: path) {
              Card { Padding(8) { VStack(spacing: 5) {
                HStack(spacing: 8) { AssetImage("kagari.nav.projects", 1, 16, 16) Grow(1) { Text("{project.name} を更新しました", size: 13) } Button("開く", action: open_recent_project, tone: secondary, size: small) }
                HStack(spacing: 6) { Caption("プロジェクト: {project.name}") Spacer Caption("{project.date}") }
              } } }
            }
          }
        } else {
          Card { Padding(10) { Caption("プロジェクトを保存すると、ファイルの更新履歴がここに表示されます。") } }
        }
      } else {
        VStack(spacing: 0) {
          Padding(8) { HStack(spacing: 10) { Grow(42) { Text("項目", size: 12) } Grow(32) { Text("プロジェクト", size: 12) } Grow(26) { Text("更新日時", size: 12) } } }
          Spacer
          If(has_recents) {
            ForEach(recent_project_items, project, key: path) {
              Padding(8) { HStack(spacing: 10) { AssetImage("kagari.nav.projects", 1, 16, 16) Grow(42) { Text("{project.name} を更新しました", size: 14) } Grow(32) { Text("{project.name}", size: 14) } Grow(26) { Caption("{project.date}") } Button("開く", action: open_recent_project, tone: secondary, size: small) } }
              Spacer
            }
          } else {
            Padding(10) { Caption("プロジェクトを保存すると、ファイルの更新履歴がここに表示されます。") }
          }
        }
      }
    }
  }

component HomePanel() {
    HStack(spacing: 0) {
      Align(stretch) { HomeNavRail() }
      Grow(1) {
        ScrollView(680) {
          Padding(horizontal: 28, vertical: 16) {
            VStack(spacing: 18) {
              HomeHero()
              RecentCardsGrid()
              RecentWorkTable()
            }
          }
        }
      }
    }
  }

component HomeFooter() {
    Card {
      Padding(8) {
        HStack(spacing: 8) {
          Caption("KAGARI VFX · ホーム")
          Spacer
          Caption("v0.3.0")
        }
      }
    }
  }
